%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Pre-Employment Screening]
    A([Start]) --> B[Conduct pre-employment screening\\nGCOR]
    B --> C{Passes initial screen?}
    C -- No --> D[Escalate to Rules Officer\\nGCOR]
    C -- Yes --> E[Allocate slot and confirm employment]
  end

  subgraph P2[Phase 2: Random Testing]
    E --> F[Schedule random drug test\\NetControl]
    F --> G{Test scheduled successfully?}
    G -- No --> Hold1([Hold])
    G -- Yes --> H[Conduct random drug test\\NetControl]
  end

  subgraph P3[Phase 3: Post-Accident Testing]
    H --> I{Positive test result?}
    I -- Yes --> J[Notify Train Dispatcher\\I-ETMS]
    I -- No --> K[End]
  end

  subgraph P4[Phase 4: Reasonable Suspicion Testing]
    J --> L[Conduct reasonable suspicion drug test\\Umler]
    L --> M{Positive test result?}
    M -- Yes --> N[Notify Chief Safety Officer/VP Safety\\C3RS]
    M -- No --> O[End]
  end

  subgraph P5[Phase 5: Test Collection and Analysis]
    N --> P[Collect and analyze drug test sample\\PS Technology]
    P --> Q{Test results available?}
    Q -- No --> Hold2([Hold])
    Q -- Yes --> R[Review test results\\C3RS]
  end

  subgraph P6[Phase 6: Documentation and Reporting]
    R --> S[Document findings\\TRAIN II]
    S --> T{Documentation complete?}
    T -- No --> Hold3([Hold])
    T -- Yes --> U[Report to regulatory bodies\\TRAIN II]
    U --> V[End]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a