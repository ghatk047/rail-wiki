%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Initiation]
    A([Start]) --> B[Initiate Merger Planning\\NetControl service design use]
    B --> C{Planning Approved?}
    C -- Yes --> D[Conduct Network Impact Analysis\\NetControl, I-ETMS]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Preparation]
    D --> E[Prepare STB Application\\NetControl, I-ETMS]
    E --> F{Application Ready?}
    F -- Yes --> G[Review and Validate Application\\NetControl, I-ETMS]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Submission]
    G --> H{Validation Passed?}
    H -- Yes --> I[Submit Application to STB\\NetControl, I-ETMS]
    H -- No --> E
    I --> J[Monitor STB Review Process\\NetControl, I-ETMS]
  end

  subgraph P4[Phase 4: Response]
    J --> K{STB Comments Received?}
    K -- Yes --> L[Respond to STB Comments\\NetControl, I-ETMS]
    K -- No --> Hold3([Hold])
    L --> M[Review and Validate Revised Application\\NetControl, I-ETMS]
  end

  subgraph P5[Phase 5: Finalization]
    M --> N{Comments Addressed?}
    N -- Yes --> O[Finalize Merger Agreement\\NetControl, I-ETMS]
    N -- No --> L
    O --> P[Implement Merger Plan\\NetControl, I-ETMS]
  end

  subgraph P6[Phase 6: Integration and Reporting]
    P --> Q{Implementation Complete?}
    Q -- Yes --> R[Review and Adjust Implementation\\NetControl, I-ETMS]
    Q -- No --> Hold4([Hold])
    R --> S[Finalize Network Integration\\NetControl, I-ETMS]
    S --> T[Report to STB on Completion\\NetControl, I-ETMS]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a