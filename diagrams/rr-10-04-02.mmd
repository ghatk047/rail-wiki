%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Initiate Auction Process]
    A([Start]) --> B[Initiate Auction Process\nup.com secure portal]
    B --> C{Auction initiated successfully?}
    C -- No --> B
    C -- Yes --> D[Bid Preparation\nLoup Logistics]
  end

  subgraph P2[Phase 2: Bid Preparation]
    D --> E{Bid prepared correctly?}
    E -- No --> D
    E -- Yes --> F[Bid Submission\nup.com secure portal]
  end

  subgraph P3[Phase 3: Bid Submission]
    F --> G{Bid submitted successfully?}
    G -- No --> F
    G -- Yes --> H[Auction Evaluation\nTransentric]
  end

  subgraph P4[Phase 4: Auction Evaluation]
    H --> I{Evaluation complete?\nAcceptable bid found?}
    I -- No --> H
    I -- Yes --> J[Capacity Allocation\nNetControl]
  end

  subgraph P5[Phase 5: Capacity Allocation]
    J --> K{Capacity allocated successfully?}
    K -- No --> J
    K -- Yes --> L[Contract Negotiation\nup.com secure portal]
  end

  subgraph P6[Phase 6: Contract Negotiation and Activation]
    L --> M{Negotiation complete?\nAgreement reached?}
    M -- No --> L
    M -- Yes --> N[Service Readiness Check\nI-ETMS]
    N --> O{Service ready for activation?}
    O -- No --> N
    O -- Yes --> P[Final Approval\nNetControl]
    P --> Q{Approval granted?}
    Q -- No --> P
    Q -- Yes --> R[Service Activation\nI-ETMS]
    R --> S{Activation successful?}
    S -- No --> R
    S -- Yes --> T[Post-Auction Review\nLoup Logistics]
    T --> U{Review complete?\nImprovements identified?}
    U -- No --> T
    U -- Yes --> V([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style S fill:#c8791a,color:#fff,stroke:#c8791a
  style U fill:#c8791a,color:#fff,stroke:#c8791a