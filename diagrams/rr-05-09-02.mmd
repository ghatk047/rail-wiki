flowchart LR
  subgraph P1[Phase 1: Defect Detection]
    A([Start]) --> B[Detect Defect\\Wayside defect detector network]
    B --> C{FRA defect found?}
    C -- No --> D[Monitor Performance\\EHMS]
    C -- Yes --> E[Prioritize Defects\\NetControl]
  end

  subgraph P2[Phase 2: Inspection Scheduling]
    E --> F{Inspection priority met?}
    F -- No --> G([Hold])
    F -- Yes --> H[Schedule Inspection\\NetControl]
  end

  subgraph P3[Phase 3: Conduct Inspection]
    H --> I[Conduct Inspection\\Downing B. Jenks Shop]
    I --> J{Defects identified?}
    J -- No --> K([Escalate])
    J -- Yes --> L[Identify Defects\\Downing B. Jenks Shop]
  end

  subgraph P4[Phase 4: Repair Defects]
    L --> M[Repair Defects\\Downing B. Jenks Shop]
    M --> N{Repairs completed?}
    N -- No --> O([Reject])
    N -- Yes --> P[Conduct Post-Repair Inspection\\Downing B. Jenks Shop]
  end

  subgraph P5[Phase 5: Update Records and Review Compliance]
    P --> Q{Post-repair inspection passed?}
    Q -- No --> R([Hold])
    Q -- Yes --> S[Update Maintenance Records\\EHMS]
    S --> T[Review Compliance\\EHMS]
  end

  subgraph P6[Phase 6: Reporting and Adjustments]
    T --> U{Compliance met?}
    U -- No --> V([Reject])
    U -- Yes --> W[Report to Regulatory Body\\NetControl]
    W --> X[Adjust Maintenance Schedule\\NetControl]
    X --> Y([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
