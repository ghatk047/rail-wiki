%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Crew Scheduling Review]
    A([Start]) --> B[Review Crew Schedules\nCrewPro]
    B --> C{Schedules meet requirements?}
    C -- No --> D[Adjust Schedules Based on Dwell Times\nCrewPro]
    C -- Yes --> E[Conduct Rest Compliance Check\ntrackHOS-class HOS monitoring tools]
  end

  subgraph P2[Phase 2: Rest and Attendance]
    E --> F{Rest compliance met?}
    F -- No --> G[Notify Crews of Schedule Changes\nPS Technology PST]
    F -- Yes --> H[Update Attendance Records\nCrewPro]
  end

  subgraph P3[Phase 3: Terminal Operations]
    H --> I[Review Terminal Dwell Times\nNetControl]
    I --> J{Dwell times within limits?}
    J -- No --> K[Adjust Schedules Based on Dwell Times\nCrewPro]
    J -- Yes --> L[Monitor Train Speeds\nI-ETMS]
  end

  subgraph P4[Phase 4: Equipment Health]
    L --> M{Train speeds within limits?}
    M -- No --> N([Escalate])
    M -- Yes --> O[Update Equipment Health Records\nEHMS]
  end

  subgraph P5[Phase 5: Weekly Review]
    O --> P[Review Crew Attendance for the Week\nCrewPro]
    P --> Q{Attendance meets requirements?}
    Q -- No --> R[Adjust Schedules for Next Week\nCrewPro]
    Q -- Yes --> S[Finalize Schedules for Next Week\nCrewPro]
  end

  subgraph P6[Phase 6: Process Review and Reporting]
    S --> T[Notify Crews of Schedule Changes\nPS Technology PST]
    T --> U[Review and Report on Process Performance\nCrewPro]
    U --> V([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style N fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a