%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart TB

  subgraph EXTERNAL_AND_INTERLINE["🌐 External and Interline"]
    direction LR
    INTERCHANGE_PARTNER["Interchange partner railroad\nCar hire event - Interchange event - Bad order card"]
    SHIPPER_EDI["Shipper EDI\nWaybill - Consist - Umler equipment record"]
  end

  subgraph PLANNING["📅 Planning"]
    direction TB
    NETCONTROL["NetControl\nTrain sheet - Authority - Movement planning"]
    TRAINII["TRAIN II\nTele Rail Automated Information Network Phase 2 - Tariffs - Rate Quotation"]
    LOUP_LOGISTICS["Loup Logistics\nBid, RFP and Shuttle Train Capacity Auctions - Demurrage and Accessorial Billing"]
    NETCONTROL -->|"train sheet"| TRAINII
  end

  subgraph EXECUTION_CONTROL["📋 Execution Control"]
    direction TB
    HDC["Harriman Dispatching Center HDC\nMovement planning - Track authority - PTC initialization"]
    IETMS["I-ETMS\nInteroperable Electronic Train Management System - Movement control - PTC monitoring"]
    NETCONTROL -->|"authority"| HDC
  end

  subgraph DATA_AND_ANALYTICS["📊 Data and Analytics"]
    direction TB
    SHIPMENTSIGHT["ShipmentVision\nWaybill intake - Shipment tracing - Digital customer channels"]
    UP_PORTAL["UP customer portal up.com secure portal\nFreight claims - Loss and damage - Service disruption communication"]
    UMLER["Umler\nCar hire accounting - Equipment record management - Interchange event tracking"]
    SHIPMENTSIGHT -->|"waybill"| UMLER
  end

  subgraph MECHANICAL_AND_ENGINEERING["🔧 Mechanical and Engineering"]
    direction TB
    EHMS["EHMS Equipment Health Management System\nEquipment health monitoring - Maintenance scheduling - Defect detection"]
    WABTRAX["Wabtrax\nTrack geometry data collection - Track condition assessment - Defect detector alarm"]
  end

  INTERCHANGE_PARTNER -->|"bad order card"| HDC
  SHIPPER_EDI -->|"waybill"| NETCONTROL
  TRAINII -->|"tariffs"| LOUP_LOGISTICS
  HDC -->|"PTC initialization"| IETMS
  IETMS -->|"movement control"| UMLER
  EHMS -->|"defect detector alarm"| WABTRAX

  classDef ext fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
  classDef plan fill:#fff7ed,stroke:#ea580c,color:#7c2d12
  classDef exec fill:#20242b,color:#fff,stroke:#20242b
  classDef data fill:#c8791a,color:#fff,stroke:#c8791a
  classDef mech fill:#e6f5e7,stroke:#3d7b1e,color:#3d7b1e

  class INTERCHANGE_PARTNER,SHIPPER_EDI ext
  class NETCONTROL,TRAINII,LOUP_LOGISTICS plan
  class HDC,IETMS exec
  class SHIPMENTSIGHT,UP_PORTAL,UMLER data
  class EHMS,WABTRAX mech