%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Data Collection Initiation]
    A([Start]) --> B[Initiate data collection\\NetControl]
    B --> C{Data within capacity?}
    C -- No --> B
    C -- Yes --> D[Integrate and clean data\\NetControl, I-ETMS]
  end

  subgraph P2[Phase 2: Anomaly Detection]
    D --> E[Detect anomalies\\NetControl, I-ETMS]
    E --> F{Anomalies detected?}
    F -- No --> G[Root cause analysis\\NetControl, I-ETMS]
    F -- Yes --> Hold1([Hold])
  end

  subgraph P3[Phase 3: Root Cause Analysis]
    G --> H{Root cause identified?}
    H -- No --> E
    H -- Yes --> I[Develop action plan\\VP Network Planning Operations]
  end

  subgraph P4[Phase 4: Action Plan Execution]
    I --> J[Execute action plan\\Train Dispatcher, Control Operator]
    J --> K{Action completed?}
    K -- No --> Hold2([Hold])
    K -- Yes --> L[Performance monitoring\\NetControl, I-ETMS]
  end

  subgraph P5[Phase 5: Continuous Improvement]
    L --> M{Performance within limits?}
    M -- No --> D
    M -- Yes --> N[Feedback loop\\CIO]
  end

  subgraph P6[Phase 6: Regulatory and Security Checks]
    N --> O[Regulatory compliance check\\Chief Dispatcher]
    O --> P[Security audit\\Cybersecurity]
    P --> Q{Compliance met?}
    Q -- No --> Escalate1([Escalate])
    Q -- Yes --> R[Final review and reporting\\Chairman, President and CEO]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style R fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Escalate1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a