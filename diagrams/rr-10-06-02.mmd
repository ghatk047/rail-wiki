%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Customer Request Review]
    A([Start]) --> B[Review customer request\nup.com secure portal]
    B --> C{Request valid?}
    C -- No --> Hold1([Hold])
    C -- Yes --> D[Calculate rate\nLoup Logistics]
  end

  subgraph P2[Phase 2: Rate Calculation]
    D --> E{Rate acceptable?}
    E -- No --> Rej1([Reject])
    E -- Yes --> F[Review proposal\nup.com secure portal]
  end

  subgraph P3[Phase 3: Proposal Review]
    F --> G{Proposal approved?}
    G -- No --> B
    G -- Yes --> H[Prepare waybill\nShipmentVision]
  end

  subgraph P4[Phase 4: Waybill Preparation]
    H --> I{Waybill complete?}
    I -- No --> Hold2([Hold])
    I -- Yes --> J[Check regulatory compliance\nUmler]
  end

  subgraph P5[Phase 5: Regulatory Compliance Check]
    J --> K{Compliant?}
    K -- No --> Rej2([Reject])
    K -- Yes --> L[Obtain customer approval\nup.com secure portal]
  end

  subgraph P6[Phase 6: Finalization and Dispatch]
    L --> M{Customer approved?}
    M -- No --> B
    M -- Yes --> N[Finalize waybill\nShipmentVision]
    N --> O[Setup billing\nLoup Logistics]
    O --> P[Notify customer\nup.com secure portal]
    P --> Q[Archive waybill\nShipmentVision]
    Q --> R[Audit review\nShipmentVision]
    R --> S{Audit passed?}
    S -- No --> Rej3([Reject])
    S -- Yes --> T[Final approval and dispatch\nNetControl]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Rej2 fill:#20242b,color:#fff,stroke:#20242b
  style Rej3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style S fill:#c8791a,color:#fff,stroke:#c8791a