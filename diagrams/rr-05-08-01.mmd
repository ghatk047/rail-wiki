%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Defect Detection]
    A([Start]) --> B[Detect Defect\\Wayside defect detector network]
    B --> C{Defect found?}
    C -- No --> A
    C -- Yes --> D[Classify Defect\\Umler]
  end

  subgraph P2[Phase 2: Repair Assignment]
    D --> E{Classification complete?}
    E -- No --> B
    E -- Yes --> F[Assign Repair Task\\PS Technology]
  end

  subgraph P3[Phase 3: Inspection and Repair]
    F --> G{Task assigned?}
    G -- No --> D
    G -- Yes --> H[Inspect Rolling Stock\\EHMS]
  end

  subgraph P4[Phase 4: Verification]
    H --> I{Inspection complete?}
    I -- No --> F
    I -- Yes --> J[Repair Defect\\Wabtec Modular Control Architecture]
  end

  subgraph P5[Phase 5: Final Checks]
    J --> K{Repair complete?}
    K -- No --> H
    K -- Yes --> L[Verify Repair\\EHMS]
  end

  subgraph P6[Phase 6: Closure and Review]
    L --> M{Verification passed?}
    M -- No --> J
    M -- Yes --> N[Update Defect Log\\Umler]
    N --> O[Release for Service\\NetControl]
    O --> P{Service released?}
    P -- No --> L
    P -- Yes --> Q[Monitor Performance\\EHMS]
    Q --> R{Performance monitored?}
    R -- No --> O
    R -- Yes --> S[Review and Improve\\Umler]
    S --> T{Improvement reviewed?}
    T -- No --> Q
    T -- Yes --> U[Implement Improvements\\Wabtec Modular Control Architecture]
    U --> V{Improvements implemented?}
    V -- No --> S
    V -- Yes --> W[Close Defect Case\\Umler]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style W fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
