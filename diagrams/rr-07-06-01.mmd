%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Incident Detection]
    A([Start]) --> B[Detect incident\\NetControl]
    B --> C{Incident detected?}
    C -- Yes --> D[Report initial details\\C3RS]
    C -- No --> A
  end

  subgraph P2[Phase 2: Initial Reporting]
    D --> E{Initial report complete?}
    E -- Yes --> F[Review and classify incident\\C3RS]
    E -- No --> Hold1([Hold])
  end

  subgraph P3[Phase 3: Review and Classification]
    F --> G{Incident classified as close call?}
    G -- Yes --> H[Initiate investigation\\Chief Safety Officer / VP Safety]
    G -- No --> Hold2([Hold])
  end

  subgraph P4[Phase 4: Investigation Initiation]
    H --> I[Collect data\\NetControl, I-ETMS]
    I --> J{Data collection complete?}
    J -- Yes --> K[Conduct root cause analysis\\C3RS, EHMS]
    J -- No --> Hold1
  end

  subgraph P5[Phase 5: Root Cause Analysis]
    K --> L{Root cause identified?}
    L -- Yes --> M[Develop corrective action plan\\Chief Safety Officer / VP Safety]
    L -- No --> Hold2
  end

  subgraph P6[Phase 6: Corrective Actions and Review]
    M --> N[Implement corrective actions\\Train Dispatcher, Yardmaster]
    N --> O{Corrective actions implemented?}
    O -- Yes --> P[Review corrective actions\\Rules Officer]
    O -- No --> Hold1
    P --> Q{Corrective actions effective?}
    Q -- Yes --> R[Final reporting and closure\\Chief Safety Officer / VP Safety]
    Q -- No --> Hold2
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style R fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a