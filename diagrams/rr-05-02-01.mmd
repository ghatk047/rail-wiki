%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Locomotive Identification and Scheduling]
    A([Start]) --> B[Locomotive Identification\\NetControl]
    B --> C{Scheduling Approved?}
    C -- Yes --> D[Locomotive Arrival at Shop\\NetControl]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Initial Inspection and Defect Logging]
    D --> E[Initial Inspection\\EHMS]
    E --> F{Defect Found?}
    F -- Yes --> G[Log Defect\\Umler]
    F -- No --> H[Component Replacement and Repair\\Wabtec Modular Control Architecture]
  end

  subgraph P3[Phase 3: Testing and Calibration]
    G --> E
    H --> I[Testing and Calibration\\I-ETMS]
    I --> J{Test Passed?}
    J -- Yes --> K[Final Inspection and Documentation\\Umler]
    J -- No --> L[Component Replacement and Repair\\Wabtec Modular Control Architecture]
  end

  subgraph P4[Phase 4: Release for Service]
    K --> M[Release for Service\\NetControl]
    M --> N{Service Approved?}
    N -- Yes --> O[Post-Release Monitoring\\EHMS]
    N -- No --> Hold2([Hold])
  end

  subgraph P5[Phase 5: Feedback Loop and Continuous Improvement]
    O --> P[Feedback Loop\\TRAIN II]
    P --> Q{Improvement Needed?}
    Q -- Yes --> R[Review and Documentation Update\\Umler]
    Q -- No --> S([End])
  end

  subgraph P6[Phase 6: Training and Development]
    R --> T[Training and Development\\PS Technology]
    T --> U[Performance Review and Reporting\\TRAIN II]
    U --> V{Review Complete?}
    V -- Yes --> W[Start]
    V -- No --> Hold3([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style S fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style V fill:#c8791a,color:#fff,stroke:#c8791a