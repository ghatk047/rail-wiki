%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Arrival Notification]
    A([Start]) --> B[Train Arrival Notification\\NetControl]
    B --> C{Train on schedule?}
    C -- Yes --> D[Assign Car Inspector\\Umler]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Initial Inspection]
    D --> E[Conduct Initial Inspection\\Wabtrax]
    E --> F{Inspection Passed?}
    F -- Yes --> G[Air Brake Test Preparation\\HASTUS]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Air Brake Test]
    G --> H[Conduct Air Brake Test\\Wabtrax]
    H --> I{Air Brake Test Passed?}
    I -- Yes --> J[Review Test Results\\Wabtrax]
    I -- No --> Hold2
  end

  subgraph P4[Phase 4: Notify Yardmaster of Results]
    J --> K[Notify Yardmaster of Results\\NetControl]
    K --> L{Yardmaster Approved?}
    L -- Yes --> M[Prepare Departure Documentation\\TRAIN II]
    L -- No --> Hold3([Hold])
  end

  subgraph P5[Phase 5: Final Inspection]
    M --> N[Conduct Final Inspection\\Wabtrax]
    N --> O{Final Inspection Passed?}
    O -- Yes --> P[Approve Departure\\NetControl]
    O -- No --> Hold3
  end

  subgraph P6[Phase 6: Update Train Schedule and Notify Dispatch]
    P --> Q[Update Train Schedule\\NetControl]
    Q --> R{Schedule Updated?}
    R -- Yes --> S[Departure Notification to Dispatch\\Harriman Dispatching Center HDC]
    R -- No --> Hold4([Hold])
    S --> T([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a