%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Preparation]
    A([Start]) --> B[Preparation for Negotiations\nTRAIN II]
    B --> C{Negotiation materials ready?}
    C -- No --> B
    C -- Yes --> D[Initial Meeting with Union Representatives\nNetControl for scheduling]
  end

  subgraph P2[Phase 2: Review Proposals]
    D --> E[Review and Analysis of Union Proposals\nUmler for data analysis]
    E --> F{Proposals analyzed?}
    F -- No --> E
    F -- Yes --> G[Drafting Counterproposals\nTRAIN II for document management]
  end

  subgraph P3[Phase 3: Negotiation Meetings]
    G --> H[Negotiation Meetings with Union Representatives\nNetControl for scheduling, I-ETMS for communication]
    H --> I{Negotiations successful?}
    I -- No --> G
    I -- Yes --> J[Final Agreement Review\nUmler for data comparison, TRAIN II for document review]
  end

  subgraph P4[Phase 4: Distribution]
    J --> K{Agreement reviewed?}
    K -- No --> J
    K -- Yes --> L[Distribution of Final Agreement\nTRAIN II for document distribution]
  end

  subgraph P5[Phase 5: Training]
    L --> M[Training for New Contract Terms\nTEY New Hire Training program, Mobile classroom training trailers]
  end

  subgraph P6[Phase 6: Feedback and Monitoring]
    M --> N[Feedback Collection from Employees\nTRAIN II for feedback collection]
    N --> O{Feedback collected?}
    O -- No --> N
    O -- Yes --> P[Review and Address Employee Feedback\nTRAIN II for document management]
    P --> Q{Feedback addressed?}
    Q -- No --> P
    Q -- Yes --> R[Monitoring Compliance with New Contract Terms\nTRAIN II for monitoring]
    R --> S{Compliance monitored?}
    S -- No --> R
    S -- Yes --> T[Annual Review and Update of Contract Terms\nTRAIN II for document management]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style S fill:#c8791a,color:#fff,stroke:#c8791a