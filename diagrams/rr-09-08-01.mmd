%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Shipment Notification]
    A([Start]) --> B[Receive Shipment Notification\nup.com customer portal]
    B --> C{Shipment valid?}
    C -- No --> Hold1([Hold])
    C -- Yes --> D[Assign Yard Resources\nNetControl]
  end

  subgraph P2[Phase 2: Container Preparation]
    D --> E[Prepare Container Fleet\nUPGo]
    E --> F{Containers ready?}
    F -- No --> E
    F -- Yes --> G[Load Automotive Vehicles\nUPGo]
  end

  subgraph P3[Phase 3: Pre-Dispatch Inspection]
    G --> H[Conduct Pre-Dispatch Inspection\nEHMS]
    H --> I{Inspection passed?}
    I -- No --> Hold2([Hold])
    I -- Yes --> J[Update Terminal Status\nNetControl]
  end

  subgraph P4[Phase 4: Train Dispatch]
    J --> K[Dispatch Train\nI-ETMS]
    K --> L[Monitor Train Movement\nI-ETMS]
    L --> M{Train on track?}
    M -- No --> Hold3([Hold])
    M -- Yes --> N[Assess Vehicle Damage\nEHMS]
  end

  subgraph P5[Phase 5: Notification and Settlement]
    N --> O{Damage found?}
    O -- Yes --> P[Notify BCO/Drayman\nup.com customer portal]
    O -- No --> Q[Update Interline Settlement System\nISS / SSDX / CHDX]
  end

  subgraph P6[Phase 6: Finalization]
    Q --> R[Finalize Process\nNetControl]
    R --> S([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style S fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a