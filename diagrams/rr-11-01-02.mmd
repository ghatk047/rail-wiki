%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Arrival Notification]
    A([Start]) --> B[Train Arrival Notification\\NetControl]
    B --> C{Track Authority Granted?}
    C -- Yes --> D[Car Inspection\\Wabtrax]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Car Inspection]
    D --> E{FRA Defect Found?}
    E -- Yes --> Rej1([Reject])
    E -- No --> F[Update Umler Register\\Umler]
  end

  subgraph P3[Phase 3: Prepare for Transfer]
    F --> G{Interchange Accepted?}
    G -- Yes --> H[Prepare for Transfer\\PS Technology]
    G -- No --> Hold2([Hold])
  end

  subgraph P4[Phase 4: Car Transfer]
    H --> I[Car Transfer\\PS Technology]
    I --> J{Air Brake Test Passed?}
    J -- Yes --> K[Update CHARM Accounting\\CHARM]
    J -- No --> D
  end

  subgraph P5[Phase 5: Final Inspection and Departure]
    K --> L[Final Inspection and Departure\\Wabtrax]
    L --> M{Car Bad Ordered?}
    M -- Yes --> Rej2([Reject])
    M -- No --> N[Update ISS/SSDX\\ISS]
  end

  subgraph P6[Phase 6: Post-Departure Review]
    N --> O[Notify Neighboring Railroad\\NetControl]
    O --> P[Post-Departure Review\\Umler]
    P --> Q{Track Defect Found?}
    Q -- Yes --> Hold3([Hold])
    Q -- No --> R[Update EHMS\\EHMS]
  end

  subgraph P7[Phase 7: Close Process]
    R --> S[Close Process\\CHARM]
    S --> T([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Rej2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a