%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Identify Conflicting Paths]
    A([Start]) --> B[Identify Conflicting Train Paths\\NetControl]
    B --> C{Conflicts Identified?}
    C -- No --> D[Assign Train Movements\\NetControl]
    C -- Yes --> E[Evaluate Train Priorities\\NetControl]
  end

  subgraph P2[Phase 2: Evaluate and Assign]
    E --> F{Priorities Evaluated?}
    F -- No --> E
    F -- Yes --> G[Assign Train Movements\\NetControl]
  end

  subgraph P3[Phase 3: Monitor Movements]
    G --> H[Monitor Train Movements\\NetControl]
    H --> I{Movements Monitored?}
    I -- No --> H
    I -- Yes --> J[Resolve Conflicts\\NetControl]
  end

  subgraph P4[Phase 4: Resolve and Update]
    J --> K{Conflicts Resolved?}
    K -- No --> J
    K -- Yes --> L[Update Train Schedules\\NetControl]
  end

  subgraph P5[Phase 5: Notify and Monitor Departures]
    L --> M[Notify Train Crews\\PS Technology]
    M --> N[Monitor Train Departures\\NetControl]
    N --> O{Departures Monitored?}
    O -- No --> N
    O -- Yes --> P[Adjust Train Movements\\NetControl]
  end

  subgraph P6[Phase 6: Finalize and Document]
    P --> Q{Movements Adjusted?}
    Q -- No --> P
    Q -- Yes --> R[Finalize Train Movements\\NetControl]
    R --> S[Update Train Status\\NetControl]
    S --> T[Review and Document Process\\NetControl]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a