%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Plan Inspection Route]
    A([Start]) --> B[Plan inspection route\\NetControl]
    B --> C{Route approved?}
    C -- Yes --> D[Assign inspection crew\\Umler]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Conduct Visual Inspection]
    D --> E[Conduct visual inspection\\Wabtrax]
    E --> F{Visual defects found?}
    F -- Yes --> G[Record inspection data\\RailAI]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Conduct Walking Inspection]
    G --> H[Conduct walking inspection\\Track geometry car]
    H --> I{Walking defects found?}
    I -- Yes --> J[Record inspection data\\RailAI]
    I -- No --> Hold3([Hold])
  end

  subgraph P4[Phase 4: Analyze Inspection Data]
    J --> K[Analyze inspection data\\NetControl]
    K --> L{Defects require remediation?}
    L -- Yes --> M[Plan remediation actions\\Umler]
    L -- No --> Hold4([Hold])
  end

  subgraph P5[Phase 5: Implement Remediation Actions]
    M --> N[Implement remediation actions\\PS Technology]
    N --> O{Remediation effective?}
    O -- Yes --> P[Update maintenance schedule\\NetControl]
    O -- No --> Hold5([Hold])
  end

  subgraph P6[Phase 6: Close Inspection Process]
    P --> Q[Report findings to management\\NetControl]
    Q --> R{Inspection complete?}
    R -- Yes --> S([End])
    R -- No --> Hold6([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style S fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Hold5 fill:#20242b,color:#fff,stroke:#20242b
  style Hold6 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a