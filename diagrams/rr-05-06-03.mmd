%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Alert Generation]
    A([Start]) --> B[Generate alert\\Wayside defect detector network]
    B --> C{Defect detected?}
    C -- Yes --> D[Notify dispatcher\\NetControl, I-ETMS]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Alert Notification]
    D --> E[Inspect locomotive\\EHMS, Umler]
    E --> F{Inspection passed?}
    F -- Yes --> G[Make maintenance decision\\EHMS, Umler]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Maintenance Decision]
    G --> H{Repair or replace?}
    H -- Repair --> I[Perform repair\\Downing B. Jenks Shop, North Platte, NE locomotive shop, Proviso Locomotive Shop, West Colton Yard and Shops]
    H -- Replace --> J[Replace locomotive\\EHMS, Umler]
  end

  subgraph P4[Phase 4: Quality Assurance Check]
    I --> K[Quality assurance check\\EHMS, Umler]
    J --> K
    K --> L{QA passed?}
    L -- Yes --> M[Return to service\\NetControl, I-ETMS]
    L -- No --> Hold3([Hold])
  end

  subgraph P5[Phase 5: Post-Service Monitoring]
    M --> N[Monitor locomotive\\Wayside defect detector network, EHMS]
    N --> O{Monitoring passed?}
    O -- Yes --> P[Update maintenance record\\EHMS, Umler]
    O -- No --> Hold4([Hold])
  end

  subgraph P6[Phase 6: Review and Improvement]
    P --> Q[Review and improve\\EHMS, Umler]
    Q --> R{Improvement needed?}
    R -- Yes --> S[Implement improvements\\EHMS, Umler]
    R -- No --> L1([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style L1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a