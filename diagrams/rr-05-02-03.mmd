%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Locomotive Identification and Classification]
    A([Start]) --> B[Locomotive Identification and Classification\\Umler]
    B --> C{Classification Approved?}
    C -- No --> B
    C -- Yes --> D[Locomotive Removal from Service\\NetControl]
  end

  subgraph P2[Phase 2: Locomotive Arrival at Shop]
    D --> E[Locomotive Arrival at Shop\\Wabtec Modular Control Architecture]
    E --> F{Arrival Confirmed?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Initial Inspection and Defect Detection\\Wayside defect detector network]
  end

  subgraph P3[Phase 3: Component Replacement and Repair]
    G --> H{Defects Found?}
    H -- No --> I[Locomotive Reassembly and Testing\\NEXSYS III-i]
    H -- Yes --> J[Component Replacement and Repair\\Downing B. Jenks Shop]
    J --> K{Repair Complete?}
    K -- No --> J
    K -- Yes --> I
  end

  subgraph P4[Phase 4: Air Brake System Test]
    I --> L[Air Brake System Test\\EHMS]
    L --> M{Air Brake Test Passed?}
    M -- No --> N([Bad Order])
    M -- Yes --> O[Final Inspection and Certification\\Umler]
  end

  subgraph P5[Phase 5: Return to Service]
    O --> P{Certification Approved?}
    P -- No --> Q([Escalate])
    P -- Yes --> R[Locomotive Return to Service\\NetControl]
  end

  subgraph P6[Phase 6: Post-Service Review and Documentation]
    R --> S[Post-Service Review and Documentation\\TRAIN II]
    S --> T{Review Complete?}
    T -- No --> U([Hold])
    T -- Yes --> V([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style N fill:#20242b,color:#fff,stroke:#20242b
  style Q fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style P fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a