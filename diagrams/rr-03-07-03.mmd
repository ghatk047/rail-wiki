%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Arrival Notification]
    A([Start]) --> B[Train Arrival Notification\\Harriman Dispatching Center HDC]
    B --> C{Track Authority Granted?}
    C -- No --> B
    C -- Yes --> D[Prepare for Arrival\\NetControl]
  end

  subgraph P2[Phase 2: Train Reception and Inspection]
    D --> E[Train Reception\\PS Technology PST]
    E --> F{Train Fully Received?}
    F -- No --> E
    F -- Yes --> G[Car Inspection\\EHMS Equipment Health Management System]
    G --> H{FRA Defect Found?}
    H -- No --> I[Air Brake Test\\Wabtrax]
  end

  subgraph P3[Phase 3: Defect Handling and Preparation]
    I --> J{Air Brake Test Passed?}
    J -- No --> G
    J -- Yes --> K[Defect Handling\\Umler]
    K --> L{Car Bad Ordered?}
    L -- No --> M[Train Preparation for Departure\\PS Technology PST]
  end

  subgraph P4[Phase 4: Departure and Settlement]
    M --> N{Departure Ready?}
    N -- No --> K
    N -- Yes --> O[Departure Notification\\Harriman Dispatching Center HDC]
    O --> P[Settlement Data Exchange\\Interline Settlement System ISS]
  end

  subgraph P5[Phase 5: Final Inspection and Documentation]
    P --> Q{Settlement Complete?}
    Q -- No --> O
    Q -- Yes --> R[Final Inspection and Documentation\\CHARM Car Hire Accounting Rate Master]
  end

  subgraph P6[Phase 6: Update Systems and Review]
    R --> S{Documentation Complete?}
    S -- No --> R
    S -- Yes --> T[Update Systems and Records\\TRAIN II Tele Rail Automated Information Network Phase 2]
    T --> U[Process Review and Improvement\\NetControl service design use]
    U --> V{Review Complete?}
    V -- No --> U
    V -- Yes --> W([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style W fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style S fill:#c8791a,color:#fff,stroke:#c8791a
  style V fill:#c8791a,color:#fff,stroke:#c8791a