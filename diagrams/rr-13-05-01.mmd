%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Project Proposal Submission]
    A([Start]) --> B[Submit project proposal\\NetControl]
    B --> C{Proposal approved?}
    C -- Yes --> D[Initiate financial analysis\\TRAIN II, CHARM]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Financial Analysis]
    D --> E[Conduct financial analysis\\TRAIN II, CHARM]
    E --> F{Financials within budget?}
    F -- Yes --> G[Initiate regulatory compliance review\\Umler, GCOR]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Regulatory Compliance Review]
    G --> H[Review regulatory compliance\\Umler, GCOR]
    H --> I{Compliance met?}
    I -- Yes --> J[Initiate stakeholder consultation\\up.com customer portal, AskRail]
    I -- No --> Hold3([Hold])
  end

  subgraph P4[Phase 4: Stakeholder Consultation]
    J --> K[Conduct stakeholder consultation\\up.com customer portal, AskRail]
    K --> L{Stakeholders approve?}
    L -- Yes --> M[Make project authorization decision\\NetControl]
    L -- No --> Hold4([Hold])
  end

  subgraph P5[Phase 5: Project Authorization Decision]
    M --> N{Project authorized?}
    N -- Yes --> O[Initiate implementation planning\\NetControl, I-ETMS]
    N -- No --> Reject1([Reject])
  end

  subgraph P6[Phase 6: Implementation Planning and Monitoring]
    O --> P[Develop implementation plan\\NetControl, I-ETMS]
    P --> Q[Initiate environmental impact assessment\\Wabtrax]
    Q --> R{Environmental impact approved?}
    R -- Yes --> S[Obtain final regulatory approval\\Umler, GCOR]
    R -- No --> Hold5([Hold])
    S --> T{Final approval granted?}
    T -- Yes --> U[Conduct project kickoff meeting\\up.com customer portal, AskRail]
    T -- No --> Hold6([Hold])
    U --> V[Initiate monitoring and reporting\\NetControl, I-ETMS]
    V --> W[Risk management review\\NetControl, I-ETMS]
    W --> X{Project completed?}
    X -- Yes --> Y[Close project\\NetControl]
    X -- No --> V
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style Y fill:#20242b,color:#fff,stroke:#20242b
  style Reject1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Hold5 fill:#20242b,color:#fff,stroke:#20242b
  style Hold6 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a
  style X fill:#c8791a,color:#fff,stroke:#c8791a