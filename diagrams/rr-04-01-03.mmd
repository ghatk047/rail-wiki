flowchart LR
  subgraph P1[Phase 1: Crew Shortage Identification]
    A([Start]) --> B{Identify Crew Shortage?\\NetControl}
    B -- Yes --> C[Evaluate Crew Availability\\PS Technology PST]
    B -- No --> D([End])
  end

  subgraph P2[Phase 2: Assign Crew Members]
    C --> E{Crew Available?\\PS Technology PST}
    E -- Yes --> F[Assign Crew Members\\PS Technology PST]
    E -- No --> Hold1([Hold])
  end

  subgraph P3[Phase 3: Notify Crew Members]
    F --> G{Notify Successful?\\PS Technology PST}
    G -- No --> H[Retry Notification\\PS Technology PST]
    G -- Yes --> I[Verify Crew Status\\NetControl]
  end

  subgraph P4[Phase 4: Update Systems]
    I --> J{Status Verified?\\NetControl}
    J -- Yes --> K[Update Crew Management System\\CloudMoyo Crew Management CCM]
    J -- No --> Hold2([Hold])
  end

  subgraph P5[Phase 5: Hours of Service Compliance]
    K --> L{HOS Compliance?\\trackHOS-class HOS monitoring tools}
    L -- No --> M[Adjust Crew Schedule\\PS Technology PST]
    L -- Yes --> N[Finalize Crew Assignment\\NetControl]
  end

  subgraph P6[Phase 6: Confirm and Monitor]
    N --> O{Assignment Finalized?\\NetControl}
    O -- No --> Hold3([Hold])
    O -- Yes --> P[Confirm Crew Readiness\\NetControl]
    P --> Q{Crew Ready?\\NetControl}
    Q -- Yes --> R[Update Dispatching System\\NetControl]
    Q -- No --> S[Escalate Issue]
    R --> T[Monitor Crew Performance\\NetControl]
    T --> U([End])
  end

