%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Incident Identification]
    A([Start]) --> B[Identify the Incident\\NetControl]
    B --> C{Incident reported?}
    C -- Yes --> D[Notify the Dispatcher\\I-ETMS]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Severity Assessment]
    D --> E[Assess Incident Severity\\C3RS]
    E --> F{Severity assessed?}
    F -- Yes --> G[Initiate Safety Investigation\\Umler]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Data Gathering]
    G --> H[Gather Incident Data\\EHMS]
    H --> I{Data gathered?}
    I -- Yes --> J[Review Incident Data\\TRAIN II]
    I -- No --> Hold3([Hold])
  end

  subgraph P4[Phase 4: Report Drafting]
    J --> K{Data reviewed?}
    K -- Yes --> L[Draft Incident Report\\NetControl]
    K -- No --> H
  end

  subgraph P5[Phase 5: Report Approval]
    L --> M[Review and Approve Report\\I-ETMS]
    M --> N{Report approved?}
    N -- Yes --> O[File Incident Report\\Umler]
    N -- No --> Hold4([Hold])
  end

  subgraph P6[Phase 6: Notification and Review]
    O --> P[Notify Affected Parties\\NetControl]
    P --> Q[Update Safety Protocols\\C3RS]
    Q --> R{Protocols updated?}
    R -- Yes --> S[Monitor and Review\\TRAIN II]
    R -- No --> Hold5([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style S fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Hold5 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a