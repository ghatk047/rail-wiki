%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Receive Crew Assignment Request]
    A([Start]) --> B[Receive Crew Assignment Request\nPS Technology] --> C{Crew Assignment Valid?}
    C -- No --> D([Bad Order])
    C -- Yes --> E[Review CBA Rules and Staffing Requirements\nGCOR, Umler]
  end

  subgraph P2[Phase 2: Identify Available Crews]
    E --> F{Staffing Requirements Met?}
    F -- No --> G[Identify Additional Crews\nCloudMoyo Crew Management CCM]
    F -- Yes --> H[Assign Crews to District\nPS Technology, CloudMoyo Crew Management CCM]
  end

  subgraph P3[Phase 3: Notify and Approve Assignment]
    H --> I[Notify Crews of Assignment\nPS Technology, CloudMoyo Crew Management CCM] --> J{Crews Acknowledged?}
    J -- No --> K([Hold])
    J -- Yes --> L[Review and Approve Assignment\nLocal Chairman / General Chairman union]
  end

  subgraph P4[Phase 4: Update Crew District Plan]
    L --> M{Assignment Approved?}
    M -- No --> N([Reject])
    M -- Yes --> O[Update Crew District Plan\nPS Technology, CloudMoyo Crew Management CCM] --> P[Monitor Crew Compliance\nTrainmaster]
  end

  subgraph P5[Phase 5: Adjust Crew District if Necessary]
    P --> Q{Compliance Issues Found?}
    Q -- No --> R([End])
    Q -- Yes --> S[Adjust Crew District\nSuperintendent Division]
  end

  subgraph P6[Phase 6: Notify and Approve Adjustments]
    S --> T[Notify All Stakeholders of Adjustments\nCloudMoyo Crew Management CCM] --> U{Stakeholders Acknowledged?}
    U -- No --> V([Hold])
    U -- Yes --> W[Review and Approve Adjustments\nLocal Chairman / General Chairman union]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style R fill:#20242b,color:#fff,stroke:#20242b
  style D fill:#20242b,color:#fff,stroke:#20242b
  style K fill:#20242b,color:#fff,stroke:#20242b
  style N fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style U fill:#c8791a,color:#fff,stroke:#c8791a