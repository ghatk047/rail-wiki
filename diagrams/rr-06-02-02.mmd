flowchart LR
  subgraph P1[Phase 1: Initiation]
    A([Start]) --> B[Initiate Automated Track Inspection\\nWabtrax]
    B --> C{Inspection initiated successfully?}
    C -- Yes --> D[Deploy Track Geometry Car\\nTrack geometry car generic]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Data Collection]
    D --> E[Analyze Inspection Data\\nRailAI Tetra Tech]
    E --> F{Data analysis complete?}
    F -- Yes --> G[Review and Prioritize Anomalies\\nNetControl]
    F -- No --> Hold1
  end

  subgraph P3[Phase 3: Repair Planning]
    G --> H{Anomalies prioritized?}
    H -- Yes --> I[Schedule Repairs\\nNetControl]
    H -- No --> E
  end

  subgraph P4[Phase 4: Execution]
    I --> J{Repairs scheduled successfully?}
    J -- Yes --> K[Execute Repairs\\nAssistant Foreman track]
    J -- No --> Hold1
  end

  subgraph P5[Phase 5: Verification]
    K --> L{Repairs executed successfully?}
    L -- Yes --> M[Verify Repairs\\nTrack geometry car generic]
    L -- No --> I
  end

  subgraph P6[Phase 6: Reporting and Improvement]
    M --> N{Repairs verified successfully?}
    N -- Yes --> O[Update Maintenance Records\\nUmler]
    N -- No --> K
    O --> P[Report to Regulatory Authorities\\nFRA Automated Track Inspection Program ATIP]
    P --> Q[Review and Improve Process\\nNetControl service design use]
    Q --> R{Process reviewed?}
    R -- Yes --> S[Implement Process Improvements\\nNetControl service design use]
    R -- No --> Q
    S --> T[Monitor and Adjust\\nNetControl service design use]
    T --> U{Monitoring complete?}
    U -- Yes --> V([End])
    U -- No --> T
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
