%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Review and Analyze Agreements]
    A([Start]) --> B[Review existing agreements\nNetControl / TCS cutover precedent]
    B --> C{Agreements meet requirements?}
    C -- No --> D[Identify gaps\nService Design / Network Planning Analyst]
    C -- Yes --> E[Develop new agreements\nUmler, PS Technology]
  end

  subgraph P2[Phase 2: Identify Regulatory Gaps]
    D --> F{Regulatory gaps identified?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Review and approve agreements\nChairman/CEO deal sponsor]
  end

  subgraph P3[Phase 3: Develop New Agreements]
    E --> H{Agreements developed?}
    H -- No --> I[Revisit existing agreements\nNetControl / TCS cutover precedent]
    H -- Yes --> J[Implement agreements\nVP Network Planning Operations]
  end

  subgraph P4[Phase 4: Implement Agreements]
    G --> K{Agreements approved?}
    K -- No --> L[Revisit regulatory gaps\nService Design / Network Planning Analyst]
    K -- Yes --> M[Monitor compliance\nTrain Dispatcher, Control Operator]
  end

  subgraph P5[Phase 5: Monitor Compliance]
    M --> N{Compliance issues found?}
    N -- No --> O[Update training programs\nService Design / Network Planning Analyst]
    N -- Yes --> P[Conduct audits\nCar Inspector Carman]
  end

  subgraph P6[Phase 6: Continuous Improvement]
    O --> Q{Training updated?}
    Q -- No --> R[Revisit agreements\nIntegration Program Management Office PMO lead]
    Q -- Yes --> S[Final implementation and monitoring\nVP Network Planning Operations]
    S --> T{Implementation complete?}
    T -- No --> U[Report to stakeholders\nChairman/CEO deal sponsor]
    T -- Yes --> V([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a