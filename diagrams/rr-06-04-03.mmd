%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Track Condition Monitoring]
    A([Start]) --> B[Track Condition Monitoring\\Wabtrax, FRA Automated Track Inspection Program ATIP, UP automated/autonomous track inspection program]
    B --> C{FRA defect found?}
    C -- Yes --> D[Report defect to Maintenance Crew\\Umler, CHARM]
    C -- No --> E[Continue monitoring]
  end

  subgraph P2[Phase 2: Work Zone Notification]
    E --> F[Work Zone Notification\\I-ETMS, NetControl]
    F --> G{Notification received?}
    G -- Yes --> H[Prepare for Maintenance\\Chief Engineer / VP Engineering]
    G -- No --> Hold1([Hold])
  end

  subgraph P3[Phase 3: Train Speed Reduction]
    H --> I[Train Speed Reduction\\I-ETMS, PTC Back Office Server BOS]
    I --> J{Speed reduced?}
    J -- Yes --> K[Notify Roadmaster\\NetControl, I-ETMS]
    J -- No --> I
  end

  subgraph P4[Phase 4: Crew Training and Briefing]
    K --> L[Crew Training and Briefing\\PS Technology, EHMS]
    L --> M{Crew briefed?}
    M -- Yes --> N[Work Zone Setup\\Roadmaster]
    M -- No --> L
  end

  subgraph P5[Phase 5: Track Maintenance Planning]
    N --> O[Track Maintenance Planning\\Umler, CHARM]
    O --> P{Plan approved?}
    P -- Yes --> Q[Track Inspection During Maintenance\\Signal Maintainer]
    P -- No --> Hold2([Hold])
  end

  subgraph P6[Phase 6: Post-Maintenance Review and Continuous Improvement]
    Q --> R[Post-Maintenance Review\\Track Supervisor]
    R --> S{Review complete?}
    S -- Yes --> T[Work Zone Removal\\Roadmaster]
    S -- No --> Q
    T --> U[Speed Restriction Removal\\Train Dispatcher]
    U --> V{Restriction removed?}
    V -- Yes --> W[Post-Operation Review\\Chief Engineer / VP Engineering]
    V -- No --> U
    W --> X[Continuous Improvement Planning\\Service Design / Network Planning Analyst]
    X --> Y{Improvement plan finalized?}
    Y -- Yes --> Z([End])
    Y -- No --> Hold3([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style Z fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style P fill:#c8791a,color:#fff,stroke:#c8791a
  style S fill:#c8791a,color:#fff,stroke:#c8791a
  style V fill:#c8791a,color:#fff,stroke:#c8791a
  style Y fill:#c8791a,color:#fff,stroke:#c8791a