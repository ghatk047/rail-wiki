%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Initiation]
    A([Start]) --> B[Initiate Annual Reporting Process\\nGCOR]
    B --> C{Data available?}
    C -- No --> D[Collect missing data\\nNetControl, I-ETMS]
    C -- Yes --> E[Review and Validate Data\\nC3RS, GCOR]
  end

  subgraph P2[Phase 2: Data Review]
    E --> F{Data valid?}
    F -- No --> D
    F -- Yes --> G[Prepare Regulatory Filings\\nTRAIN II, CHARM]
  end

  subgraph P3[Phase 3: Preparation]
    G --> H[Review and Finalize Filings\\nGCOR, Umler]
    H --> I{Filings finalized?}
    I -- No --> E
    I -- Yes --> J[Submit Filings to STB\\nNetControl, I-ETMS]
  end

  subgraph P4[Phase 4: Submission]
    J --> K[Monitor STB Response\\nGCOR, C3RS]
    K --> L{Response received?}
    L -- No --> Hold1([Hold])
    L -- Yes --> M[Address STB Feedback\\nNetControl, I-ETMS]
  end

  subgraph P5[Phase 5: Feedback Addressing]
    M --> N{Feedback addressed?}
    N -- No --> K
    N -- Yes --> O[Final Submission and Documentation\\nNetControl, I-ETMS]
  end

  subgraph P6[Phase 6: Finalization]
    O --> P[Internal Review and Approval\\nGCOR]
    P --> Q{Approved?}
    Q -- No --> M
    Q -- Yes --> R[Final Submission to STB\\nNetControl, I-ETMS]
    R --> S[Post-Submission Review and Documentation\\nGCOR, C3RS]
    S --> T{Review complete?}
    T -- No --> P
    T -- Yes --> U([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a