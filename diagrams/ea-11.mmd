    ISS["Interline Settlement System\nSwitching Settlement Data Exchange - Car Hire Data Exchange"]
    Wabtrax["Wabtrax\nTrack geometry cars - Maintenance planning"]
    Machine_Vision["Machine Vision portals\nDefect detection - Asset monitoring"]
