%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart TB

  subgraph EXT["🌐 External Feeds"]
    direction LR
    STB["Surface Transportation Board\nRegulatory Filings - Annual Reporting"]
    INTERLINE["Interchange Partner Railroad\nWaybill - Consist"]
  end

  subgraph PLANNING["📋 Planning and Service Design"]
    direction TB
    GCOR["General Code of Operating Rules\nOperating Rules Administration - Efficiency Testing"]
    NC["NetControl\nTrain sheet - Authority - Movement planning"]
    GCOR -->|"operating rules"| NC
    INTERLINE -->|"waybill - consist"| NC
  end

  subgraph EXECUTION["🚚 Execution Control"]
    direction TB
    HDC["Harriman Dispatching Center\nDispatch and Movement Control - Track authority"]
    IETMS["Interoperable Electronic Train Management System\nPTC initialization - Bad order card"]
    HDC -->|"track authority"| IETMS
    IETMS -->|"bad order card"| HDC
  end

  subgraph DATA["📊 Data and Analytics"]
    direction TB
    UMLER["Universal Machine Language Equipment Register\nEquipment record - Interchange event"]
    EHMS["Equipment Health Management System\nHealth monitoring - Maintenance scheduling"]
    TRAINII["Tele Rail Automated Information Network Phase 2\nData exchange - Reporting"]
    UMLER -->|"equipment record"| EHMS
    EHMS -->|"maintenance schedule"| TRAINII
  end

  subgraph ANALYTICS["📈 Analytics and Reporting"]
    direction TB
    C3RS["Confidential Close Call Reporting System\nClose call reporting - Root cause analysis"]
    WABTRAX["Wabtrax\nDefect detector alarm - Incident reporting"]
    C3RS -->|"close call data"| WABTRAX
    WABTRAX -->|"incident report"| C3RS
  end

  subgraph SECURITY["🔒 Security and Compliance"]
    direction TB
    PS_TECH["PS Technology\nCrew management - Hours of service"]
    STB -->|"regulatory updates"| PS_TECH
    PS_TECH -->|"hours of service"| NC
  end

  EXT -->|"regulatory filings"| PLANNING
  PLANNING -->|"train sheet - authority"| EXECUTION
  EXECUTION -->|"track authority - PTC initialization"| DATA
  DATA -->|"equipment record - maintenance schedule"| ANALYTICS
  ANALYTICS -->|"close call data - incident report"| SECURITY
  SECURITY -->|"hours of service"| EXECUTION

  classDef ext  fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
  classDef plan fill:#fff7ed,stroke:#ea580c,color:#7c2d12
  classDef exec fill:#20242b,color:#fff,stroke:#20242b
  classDef data fill:#c8e6c9,stroke:#388e3c,color:#0f5132
  classDef analy fill:#ffecb3,stroke:#fbc02d,color:#894a00
  classDef sec fill:#ffcdd2,stroke:#e53935,color:#b71c1c

  class STB,INTERLINE ext
  class GCOR,NC plan
  class HDC,IETMS exec
  class UMLER,EHMS,TRAINII data
  class C3RS,WABTRAX analy
  class PS_TECH sec