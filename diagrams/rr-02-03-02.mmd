%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Receive Movement Request]
    A([Start]) --> B[Receive Movement Request\nNetControl / CADx]
    B --> C{Track Available?}
    C -- No --> B
    C -- Yes --> D[Verify Track Conditions\nWabtrax / Wayside defect detector network]
  end

  subgraph P2[Phase 2: Verify Track Conditions]
    D --> E{FRA Defect Found?}
    E -- Yes --> Hold1([Hold])
    E -- No --> F[Issue Authority for Movement\nNetControl / CADx]
  end

  subgraph P3[Phase 3: Coordinate with Roadway Workers]
    F --> G[Coordinate with Roadway Workers\nNetControl / CADx]
    G --> H{Roadway Worker Response?}
    H -- No --> G
    H -- Yes --> I[Update Train Schedule\nNetControl / CADx]
  end

  subgraph P4[Phase 4: Monitor Train Movement]
    I --> J[Monitor Train Movement\nNetControl / CADx]
    J --> K{Train On Track?}
    K -- No --> J
    K -- Yes --> L[Review and Adjust Authority\nNetControl / CADx]
  end

  subgraph P5[Phase 5: Notify Roadway Workers]
    L --> M{Authority Adjusted?}
    M -- Yes --> N[Notify Roadway Workers\nNetControl / CADx]
    M -- No --> O[Conduct Post-Movement Review\nNetControl / CADx]
  end

  subgraph P6[Phase 6: Finalize and Report]
    O --> P{Review Complete?}
    P -- Yes --> Q[Update System Records\nNetControl / CADx]
    P -- No --> O
    Q --> R[Close Movement Request\nNetControl / CADx]
    R --> S[Report Metrics and Issues\nNetControl / CADx]
    S --> T([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style P fill:#c8791a,color:#fff,stroke:#c8791a