%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Arrival Notification]
    A([Start]) --> B[Train Arrival Notification\\NetControl]
    B --> C{Track Authority Granted?}
    C -- Yes --> D[Container Inspection\\EHMS]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Container Inspection]
    D --> E{Car Bad Ordered?}
    E -- Yes --> Rej1([Reject])
    E -- No --> F[Container Unloading\\UPGo]
  end

  subgraph P3[Phase 3: Container Storage and Loading]
    F --> G[Container Storage\\Umler]
    G --> H[Container Loading\\UPGo]
  end

  subgraph P4[Phase 4: Security Check]
    H --> I[Container Security Check\\ICTF security system]
    I --> J{Security Violation Found?}
    J -- Yes --> Rej2([Reject])
    J -- No --> K[Train Departure Preparation\\NetControl]
  end

  subgraph P5[Phase 5: Train Departure Notification]
    K --> L[Train Departure Notification\\NetControl]
    L --> M{Track Authority Granted?}
    M -- Yes --> N[Container Settlement\\ISS / SSDX / CHDX]
    M -- No --> Hold2([Hold])
  end

  subgraph P6[Phase 6: Post-Departure Review]
    N --> O[Post-Departure Review\\Umler / EHMS]
    O --> P{Review Passed?}
    P -- Yes --> Q([End])
    P -- No --> Hold3([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style Q fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Rej2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style P fill:#c8791a,color:#fff,stroke:#c8791a