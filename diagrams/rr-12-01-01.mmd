%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Dispatching]
    A([Start]) --> B[Initiate train dispatch\\NetControl]
    B --> C{Track authority granted?}
    C -- No --> Hold1([Hold])
    C -- Yes --> D[Assign crew\\PS Technology PST]
  end

  subgraph P2[Phase 2: Crew Assignment]
    D --> E{Crew available?}
    E -- No --> Rej1([Reject])
    E -- Yes --> F[Train tracking\\I-ETMS Interoperable Electronic Train Management System]
  end

  subgraph P3[Phase 3: Train Tracking]
    F --> G{Train on track?}
    G -- No --> Hold2([Hold])
    G -- Yes --> H[Monitor equipment health\\EHMS Equipment Health Management System]
  end

  subgraph P4[Phase 4: Equipment Health Monitoring]
    H --> I{Air brake test passed?}
    I -- No --> B
    I -- Yes --> J[Safety inspection\\Umler]
  end

  subgraph P5[Phase 5: Safety Inspection]
    J --> K{FRA defect found?}
    K -- No --> L[Crew management\\CloudMoyo Crew Management]
    K -- Yes --> Hold3([Hold])
  end

  subgraph P6[Phase 6: Final Review and Dispatch]
    L --> M{Train speed within limits?}
    M -- No --> B
    M -- Yes --> N[Interline settlements\\ISS / SSDX]
    N --> O{Settlements complete?}
    O -- No --> Hold4([Hold])
    O -- Yes --> P[Regulatory compliance check\\Cybersecurity — 'secure-by-design' approach unbranded]
    P --> Q{Compliance met?}
    Q -- No --> Rej2([Reject])
    Q -- Yes --> R[Customer notifications\\up.com customer portal]
    R --> S[Final review and dispatch\\NetControl]
    S --> T([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Rej2 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
