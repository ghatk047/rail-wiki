%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Data Collection and Analysis]
    A([Start]) --> B[Collect line capacity data\\Unified Plan 2020, NetControl]
    B --> C{Data complete?}
    C -- No --> B
    C -- Yes --> D[Analyze data trends\\Unified Plan 2020, NetControl]
  end

  subgraph P2[Phase 2: Route Optimization]
    D --> E[Optimize routes for efficiency\\NetControl, I-ETMS]
    E --> F{Route optimization successful?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Review optimized routes\\VP Network Planning Operations]
  end

  subgraph P3[Phase 3: Regulatory Compliance Check]
    G --> H[Check compliance with regulations\\Unified Plan 2020, NetControl]
    H --> I{Compliance met?}
    I -- No --> Rej1([Reject])
    I -- Yes --> J[Develop implementation plan\\VP Network Planning Operations]
  end

  subgraph P4[Phase 4: Coordination with Operations]
    J --> K[Coordinate with operations team\\NetControl, I-ETMS]
    K --> L{Operations coordination successful?}
    L -- No --> Hold2([Hold])
    L -- Yes --> M[Monitor and adjust routes\\Service Design / Network Planning Analyst, Train Dispatcher]
  end

  subgraph P5[Phase 5: Review and Feedback]
    M --> N[Review implementation plan\\Chairman, President and CEO]
    N --> O{Plan approved?}
    O -- No --> Rej2([Reject])
    O -- Yes --> P[Update network plan\\VP Network Planning Operations]
  end

  subgraph P6[Phase 6: Safety Audit and Deployment]
    P --> Q[Audit safety protocols\\Car Inspector, Locomotive Engineer]
    Q --> R{Safety audit passed?}
    R -- No --> Rej3([Reject])
    R -- Yes --> S[Final review by leadership\\Chairman, President and CEO]
    S --> T{Final approval given?}
    T -- No --> Rej4([Reject])
    T -- Yes --> U[Deploy new plan\\Train Dispatcher, Control Operator]
    U --> V[Post-implementation review\\Service Design / Network Planning Analyst, VP Network Planning Operations]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
