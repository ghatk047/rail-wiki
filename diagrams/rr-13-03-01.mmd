flowchart LR
  subgraph P1[Phase 1: Train Arrival Notification]
    A([Start]) --> B[Train Arrival Notification\\NetControl]
    B --> C{Train data received?}
    C -- Yes --> D[Revenue Calculation\\Interline Settlement System ISS]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Revenue Calculation]
    D --> E[Fuel Surcharge Application\\Fuel surcharge program]
    E --> F{Fuel surcharge applied?}
    F -- Yes --> G[Revenue Review and Adjustment\\Interline Settlement System ISS]
    F -- No --> E
  end

  subgraph P3[Phase 3: Revenue Review and Adjustment]
    G --> H{Review complete?}
    H -- Yes --> I[Payment Preparation\\Interline Settlement System ISS]
    H -- No --> G
  end

  subgraph P4[Phase 4: Payment Preparation]
    I --> J{Payment prepared?}
    J -- Yes --> K[Payment Execution\\Interline Settlement System ISS]
    J -- No --> I
  end

  subgraph P5[Phase 5: Payment Execution]
    K --> L{Payment executed?}
    L -- Yes --> M[Revenue Reporting\\Interline Settlement System ISS]
    L -- No --> K
  end

  subgraph P6[Phase 6: Audit and Compliance Check]
    M --> N[Audit and Compliance Check\\Interline Settlement System ISS]
    N --> O{Compliance check passed?}
    O -- Yes --> P[Dispute Resolution\\Interline Settlement System ISS]
    O -- No --> N
  end

  subgraph P7[Phase 7: Dispute Resolution]
    P --> Q{Dispute resolved?}
    Q -- Yes --> R[Continuous Improvement Review\\Interline Settlement System ISS]
    Q -- No --> P
  end

  R --> S([End])

  style A fill:#20242b,color:#fff,stroke:#20242b
  style S fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
