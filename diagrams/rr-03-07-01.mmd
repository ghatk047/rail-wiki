%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Arrival Notification]
    A([Start]) --> B[Receive Arrival Notification\\NetControl]
    B --> C{Train on schedule?}
    C -- Yes --> D[Assign Yard Crew\\PS Technology]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Pre-arrival Inspection]
    D --> E[Conduct Pre-arrival Inspection\\Wabtrax]
    E --> F{FRA defect found?}
    F -- Yes --> G[Report defect to MOW\\HASTUS]
    F -- No --> H[Prepare for Arrival\\Harriman Dispatching Center HDC]
  end

  subgraph P3[Phase 3: Train Reception and Air Brake Test]
    H --> I[Receive Train\\NetControl]
    I --> J[Perform Air Brake Test\\Wabtrax]
    J --> K{Air brake test passed?}
    K -- Yes --> L[Classify Cars\\Bailey Yard North Platte, NE]
    K -- No --> M[Retest air brakes\\Wabtrax]
  end

  subgraph P4[Phase 4: Car Classification and Accounting]
    L --> N[Update Car Hire Accounting\\CHARM]
    N --> O{Car bad ordered?}
    O -- Yes --> BadOrder([Bad Order])
    O -- No --> P[Prepare for Departure\\PS Technology]
  end

  subgraph P5[Phase 5: Post-departure Inspection and Interline Settlement]
    P --> Q[Conduct Post-departure Inspection\\Wabtrax]
    Q --> R{FRA defect found?}
    R -- Yes --> S[Report defect to MOW\\HASTUS]
    R -- No --> T[Update Interline Settlement System\\Interline Settlement System ISS]
  end

  subgraph P6[Phase 6: Notification and Completion]
    T --> U[Notify Next Railroad\\NetControl]
    U --> V([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style V fill:#20242b,color:#fff,stroke:#20242b
  style BadOrder fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a