%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Receive Movement Request]
    A([Start]) --> B[Receive movement request\nNetControl / CADx]
    B --> C{Movement request valid?}
    C -- No --> Hold1([Hold])
    C -- Yes --> D[Verify track conditions\nWabtrax / Wayside defect detector network]
  end

  subgraph P2[Phase 2: Verify Track Conditions]
    D --> E{Track condition acceptable?}
    E -- No --> B
    E -- Yes --> F[Review regulatory compliance\nNetControl / CADx]
  end

  subgraph P3[Phase 3: Review Regulatory Compliance]
    F --> G{Regulatory requirements met?}
    G -- No --> Hold2([Hold])
    G -- Yes --> H[Issue track warrant\nNetControl / CADx]
  end

  subgraph P4[Phase 4: Confirm Warrant Receipt]
    H --> I[Confirm warrant receipt\nLocomotive Engineer / Conductor]
    I --> J{Warrant confirmed?}
    J -- No --> Hold3([Hold])
    J -- Yes --> K[Conduct pre-movement inspection\nCar Inspector Carman]
  end

  subgraph P5[Phase 5: Conduct Pre-Movement Inspection]
    K --> L{Inspection passed?}
    L -- No --> I
    L -- Yes --> M[Review inspection report\nNetControl / CADx]
  end

  subgraph P6[Phase 6: Clear Track and Initiate Movement]
    M --> N{Report reviewed?}
    N -- No --> Hold4([Hold])
    N -- Yes --> O[Clear track for movement\nControl Operator]
    O --> P[Initiate train movement\nLocomotive Engineer / Conductor]
    P --> Q[Monitor train movement\nNetControl / CADx]
    Q --> R{Movement monitored?}
    R -- No --> Hold5([Hold])
    R -- Yes --> S[Update track warrant status\nNetControl / CADx]
    S --> T[Finalize track warrant control\nNetControl / CADx]
    T --> U([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Hold5 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a