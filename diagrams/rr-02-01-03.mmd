%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Receive Train Arrival Notification]
    A([Start]) --> B[Receive Train Arrival Notification\nNetControl / CADx]
    B --> C{Train on schedule?}
    C -- No --> D[Adjust Train Schedule\nNetControl / CADx]
    C -- Yes --> E[Conduct Pre-Dispatch Review\nNetControl / CADx]
  end

  subgraph P2[Phase 2: Initiate Train Dispatch]
    E --> F{Track Authority Granted?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Initiate Train Dispatch\nNetControl / CADx]
  end

  subgraph P3[Phase 3: Monitor Train Movement]
    G --> H[Monitor Train Movement\nNetControl / CADx]
    H --> I{Train on schedule?}
    I -- No --> J[Adjust Train Schedule\nNetControl / CADx]
    I -- Yes --> K[Ensure Train Safety\nNetControl / CADx, I-ETMS]
  end

  subgraph P4[Phase 4: Coordinate Interline Operations]
    K --> L{Interchange Accepted?}
    L -- No --> Rej1([Reject])
    L -- Yes --> M[Coordinate Interline Operations\nNetControl / CADx, ISS / SSDX / CHDX]
  end

  subgraph P5[Phase 5: Update Train Status]
    M --> N[Update Train Status\nNetControl / CADx]
    N --> O{Train arrived safely?}
    O -- No --> Esc1([Escalate])
    O -- Yes --> P[Conduct Post-Dispatch Review\nNetControl / CADx]
  end

  subgraph P6[Phase 6: Prepare for Next Train Arrival]
    P --> Q{Prepare complete?}
    Q -- No --> R[Adjust Train Schedule\nNetControl / CADx]
    Q -- Yes --> A([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style P fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Esc1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a