%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Identify Shortage]
    A([Start]) --> B[Identify Shortage\\nCHARM, ISS]
    B --> C{Shortage Identified?}
    C -- No --> A
    C -- Yes --> D[Assess Fleet Availability\\nUmler, TRAIN II]
  end

  subgraph P2[Phase 2: Assess Fleet Availability]
    D --> E{Fleet Available?}
    E -- No --> Hold1([Hold])
    E -- Yes --> F[Plan Distribution Strategy\\nNetControl, GCOR]
  end

  subgraph P3[Phase 3: Plan Distribution Strategy]
    F --> G{Strategy Approved?}
    G -- No --> D
    G -- Yes --> H[Dispatch Empty Cars\\nI-ETMS, PS Technology]
  end

  subgraph P4[Phase 4: Dispatch and Monitor Train Movement]
    H --> I[Monitor Train Movement\\nI-ETMS, NetControl]
    I --> J{Train on Track?}
    J -- No --> Hold2([Hold])
    J -- Yes --> K[Conduct Pre-Departure Inspection\\nEHMS, Wabtrax]
  end

  subgraph P5[Phase 5: Conduct Pre-Departure Inspection]
    K --> L{Inspection Passed?}
    L -- No --> H
    L -- Yes --> M[Update Fleet Status\\nUmler, TRAIN II]
  end

  subgraph P6[Phase 6: Coordinate and Finalize Distribution]
    M --> N[Coordinate with Interline Partners\\nISS, CHDX]
    N --> O{Coordination Successful?}
    O -- No --> F
    O -- Yes --> P[Review and Adjust Strategy\\nNetControl, GCOR]
    P --> Q{Strategy Adjusted?}
    Q -- No --> M
    Q -- Yes --> R[Finalize Distribution\\nI-ETMS, PS Technology]
    R --> S[Monitor Terminal Operations\\nYardmaster, I-ETMS, NetControl]
    S --> T{Operations Complete?}
    T -- No --> Hold3([Hold])
    T -- Yes --> U[Report and Review\\nCHARM, ISS]
    U --> V{Review Approved?}
    V -- No --> P
    V -- Yes --> W([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style W fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a
  style V fill:#c8791a,color:#fff,stroke:#c8791a