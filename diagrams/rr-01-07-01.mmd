flowchart LR
  subgraph P1[Phase 1: Data Collection]
    A([Start]) --> B[Collect network performance data\\NetControl]
    B --> C{Data collection successful?}
    C -- Yes --> D[Integrate data with I-ETMS\\I-ETMS]
    C -- No --> E([Bad Order])
  end

  subgraph P2[Phase 2: Regulatory Compliance]
    D --> F[Check regulatory compliance\\NetControl, I-ETMS]
    F --> G{Compliance met?}
    G -- Yes --> H[Analyze terminal dwell times\\NetControl, I-ETMS]
    G -- No --> E
  end

  subgraph P3[Phase 3: Performance Analysis]
    H --> I[Analyze train speeds\\NetControl, I-ETMS]
    I --> J{Analysis complete?}
    J -- Yes --> K[Generate performance report\\NetControl, I-ETMS]
    J -- No --> H
  end

  subgraph P4[Phase 4: Report Review and Submission]
    K --> L[Review and approve report\\VP Network Planning Operations]
    L --> M{Report approved?}
    M -- Yes --> N[Submit report to STB\\NetControl, I-ETMS]
    M -- No --> E
  end

  subgraph P5[Phase 5: Feedback Review]
    N --> O[Review STB feedback\\NetControl, I-ETMS]
    O --> P{Feedback reviewed?}
    P -- Yes --> Q[Update network plan\\Unified Plan 2020, NetControl]
    P -- No --> N
  end

  subgraph P6[Phase 6: Plan Implementation and Monitoring]
    Q --> R[Implement plan changes\\Unified Plan 2020, NetControl]
    R --> S{Changes implemented?}
    S -- Yes --> T[Monitor plan effectiveness\\Unified Plan 2020, NetControl]
    S -- No --> Q
    T --> U([End])
  end

