%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Anomaly Detection]
    A([Start]) --> B[Detect anomaly\\Wayside defect detector network]
    B --> C{Anomaly detected?}
    C -- No --> A
    C -- Yes --> D[Report anomaly\\NetControl]
  end

  subgraph P2[Phase 2: Initial Assessment]
    D --> E[Assess anomaly\\EHMS]
    E --> F{Initial assessment complete?}
    F -- No --> E
    F -- Yes --> G[Prioritize anomaly\\Umler]
  end

  subgraph P3[Phase 3: Prioritization]
    G --> H{Priority set?}
    H -- No --> G
    H -- Yes --> I[Assign workshop\\NetControl]
  end

  subgraph P4[Phase 4: Workshop Assignment]
    I --> J{Workshop assigned?}
    J -- No --> I
    J -- Yes --> K[Plan maintenance\\TRAIN II]
  end

  subgraph P5[Phase 5: Maintenance Planning]
    K --> L{Maintenance plan complete?}
    L -- No --> K
    L -- Yes --> M[Monitor equipment health\\EHMS]
  end

  subgraph P6[Phase 6: Execution and Review]
    M --> N{Health monitored?}
    N -- No --> M
    N -- Yes --> O[Execute maintenance\\Wabtec Modular Control Architecture]
    O --> P{Maintenance executed?}
    P -- No --> O
    P -- Yes --> Q[Review post-maintenance\\TRAIN II]
    Q --> R{Post-maintenance review complete?}
    R -- No --> Q
    R -- Yes --> S[Assure quality\\EHMS]
    S --> T{Quality assured?}
    T -- No --> S
    T -- Yes --> U[Return to service\\NetControl]
    U --> V{Returned to service?}
    V -- No --> U
    V -- Yes --> W[Monitor post-service\\EHMS]
    W --> X{Post-service monitoring complete?}
    X -- No --> W
    X -- Yes --> Y[Provide feedback\\TRAIN II]
    Y --> Z{Feedback provided?}
    Z -- No --> Y
    Z -- Yes --> L1([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style L1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
