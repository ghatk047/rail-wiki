  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style P fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a
  style V fill:#c8791a,color:#fff,stroke:#c8791a
  style X fill:#c8791a,color:#fff,stroke:#c8791a
  style Z fill:#c8791a,color:#fff,stroke:#c8791a