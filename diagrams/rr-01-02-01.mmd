%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Review Traffic Forecasts]
    A([Start]) --> B[Review traffic forecasts\nUnified Plan 2020]
    B --> C{Forecast within acceptable range?}
    C -- No --> B
    C -- Yes --> D[Develop train symbols\nNetControl]
  end

  subgraph P2[Phase 2: Create Blocking Plans]
    D --> E[Create blocking plans\nUnified Plan 2020]
    E --> F{Blocking plan feasible?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Review and approve blocking plans\nVP Network Planning Operations]
  end

  subgraph P3[Phase 3: Implement Blocking Plans]
    G --> H{Approval received?}
    H -- No --> E
    H -- Yes --> I[Implement blocking plans\nNetControl / CADx]
  end

  subgraph P4[Phase 4: Monitor Train Performance]
    I --> J[Monitor train performance\nNetControl / CADx]
    J --> K{Performance meets expectations?}
    K -- No --> L[Adjust blocking plans\nUnified Plan 2020]
    K -- Yes --> M[Update train symbols\nNetControl]
  end

  subgraph P5[Phase 5: Review Updated Symbols]
    M --> N[Review updated symbols\nVP Network Planning Operations]
    N --> O{Symbols approved?}
    O -- No --> J
    O -- Yes --> P[Implement updated symbols\nNetControl / CADx]
  end

  subgraph P6[Phase 6: Monitor Updated Performance and Final Review]
    P --> Q[Monitor updated performance\nNetControl / CADx]
    Q --> R{Performance meets expectations?}
    R -- No --> S[Final review and adjustments\nUnified Plan 2020]
    R -- Yes --> T([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a