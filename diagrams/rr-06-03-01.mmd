flowchart LR
  subgraph P1[Phase 1: Track Inspection Planning]
    A([Start]) --> B[Plan track inspection\\NetControl, I-ETMS]
    B --> C{Inspection plan approved?}
    C -- No --> B
    C -- Yes --> D[Schedule automated defect detection\\Wabtrax, FRA ATIP]
  end

  subgraph P2[Phase 2: Defect Detection by Automated Systems]
    D --> E[Detect defects using automated systems\\Wabtrax, FRA ATIP]
    E --> F{Defects detected?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Manual track inspection\\NetControl, Umler]
  end

  subgraph P3[Phase 3: Manual Track Inspection]
    G --> H{Inspection complete?}
    H -- No --> G
    H -- Yes --> I[Classify and prioritize defects\\NetControl, I-ETMS]
  end

  subgraph P4[Phase 4: Defect Classification and Prioritization]
    I --> J{Defects classified?}
    J -- No --> I
    J -- Yes --> K[Assign repair crew\\NetControl, PS Technology]
  end

  subgraph P5[Phase 5: Track Repair Execution]
    K --> L[Execute track repair\\NetControl, EHMS]
    L --> M{Repair complete?}
    M -- No --> L
    M -- Yes --> N[Post-repair inspection\\NetControl, Umler]
  end

  subgraph P6[Phase 6: Post-Repair Inspection and Continuous Improvement]
    N --> O{Inspection passed?}
    O -- No --> Hold2([Hold])
    O -- Yes --> P[Close defect and report\\NetControl, I-ETMS]
    P --> Q[Update maintenance record\\NetControl, Umler]
    Q --> R[Review continuous improvement\\NetControl, I-ETMS]
    R --> S{Improvements identified?}
    S -- No --> T([End])
    S -- Yes --> U[Train and develop\\NetControl, PS Technology]
    U --> V[Performance review and report\\NetControl, I-ETMS]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style H fill:#c8791a,color:#fff,stroke:#c8791a
  style J fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style S fill:#c8791a,color:#fff,stroke:#c8791a