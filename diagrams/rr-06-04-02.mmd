%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Initiation]
    A([Start]) --> B[Initiate Track Inspection Plan\\NetControl]
    B --> C{Inspection plan approved?}
    C -- No --> A
    C -- Yes --> D[Deploy Track Geometry Car\\Track geometry car generic]
  end

  subgraph P2[Phase 2: Condition Assessment]
    D --> E[Review Track Condition Report\\NetControl]
    E --> F{Condition report reviewed?}
    F -- No --> D
    F -- Yes --> G[Update PTC System\\I-ETMS Interoperable Electronic Train Management System]
  end

  subgraph P3[Phase 3: Field Inspection]
    G --> H[Conduct Field Inspection\\Wabtrax]
    H --> I{Inspection completed?}
    I -- No --> G
    I -- Yes --> J[Review Field Inspection Report\\NetControl]
  end

  subgraph P4[Phase 4: Repairs and Maintenance]
    J --> K[Implement Repairs and Maintenance\\Assistant Foreman track]
    K --> L{Repairs implemented?}
    L -- No --> H
    L -- Yes --> M[Verify Repairs with Automated Inspection\\UP automated/autonomous track inspection program unbranded]
  end

  subgraph P5[Phase 5: Maintenance Scheduling]
    M --> N{Repairs verified?}
    N -- No --> K
    N -- Yes --> O[Update Maintenance Schedule\\NetControl]
  end

  subgraph P6[Phase 6: Reporting and Improvement]
    O --> P[Report to Regulatory Authorities\\Chief Engineer / VP Engineering]
    P --> Q{Report submitted?}
    Q -- No --> O
    Q -- Yes --> R[Review and Improve Process\\NetControl]
    R --> S{Process reviewed?}
    S -- No --> P
    S -- Yes --> T[Implement Process Improvements\\Track Supervisor]
    T --> U([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style S fill:#c8791a,color:#fff,stroke:#c8791a