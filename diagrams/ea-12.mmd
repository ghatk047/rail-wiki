%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart TB

  subgraph EXT["🌐 External and Interline"]
    direction LR
    ISS["Interline Settlement System\nSettlement - Data exchange - Car hire"]
    CHDX["Car Hire Data Exchange\nData sharing - Contract management"]
    SSDX["Switching Settlement Data Exchange\nSettlement - Data exchange"]
    ISS -->|"settlement data"| CHDX
    CHDX -->|"car hire data"| SSDX
  end

  subgraph PLAN["📋 Planning"]
    direction TB
    NC["NetControl\nTrain sheet - Authority - Movement planning"]
    PST["PS Technology PST\nCrew management - Scheduling"]
    OPC["Operating Practices Command Center\nPolicy enforcement - Training"]
    NC -->|"train sheet"| PST
    PST -->|"crew schedule"| OPC
  end

  subgraph EXEC["🚚 Execution Control"]
    direction TB
    IETMS["I-ETMS Interoperable Electronic Train Management System\nMovement control - PTC initialization"]
    COMMIT["COMMIT Situational Awareness Testing program\nTesting - Simulation - Training"]
    MV["Machine Vision portals\nInspection - Defect detection"]
    IETMS -->|"track authority"| COMMIT
    COMMIT -->|"defect data"| MV
  end

  subgraph DATA["📊 Data and Analytics"]
    direction TB
    UMLER["Umler Universal Machine Language Equipment Register\nEquipment record - Interchange event"]
    EHMS["EHMS Equipment Health Management System\nHealth monitoring - Maintenance scheduling"]
    TRAINII["TRAIN II Tele Rail Automated Information Network Phase 2\nData integration - Analytics"]
    UMLER -->|"equipment record"| EHMS
    EHMS -->|"maintenance data"| TRAINII
  end

  subgraph SEC["🔒 Cybersecurity"]
    direction TB
    CS["Cybersecurity — 'secure-by-design' approach\nSecurity policies - Threat detection"]
    CS -->|"security protocols"| NC
    CS -->|"security protocols"| IETMS
    CS -->|"security protocols"| UMLER
  end

  ISS -->|"settlement data"| NC
  PST -->|"crew schedule"| IETMS
  OPC -->|"policy data"| EXEC
  COMMIT -->|"test results"| DATA
  MV -->|"inspection data"| DATA
  EHMS -->|"health data"| TRAINII

  classDef ext  fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
  classDef plan fill:#fff7ed,stroke:#ea580c,color:#7c2d12
  classDef exec fill:#b3e5fc,stroke:#0288d1,color:#0c4a6e
  classDef data fill:#f9fbe7,stroke:#fbc02d,color:#7c2d12
  classDef sec  fill:#ffe0b2,stroke:#ff6f00,color:#7c2d12

  class ISS,CHDX,SSDX ext
  class NC,PST,OPC plan
  class IETMS,COMMIT,MV exec
  class UMLER,EHMS,TRAINII data
  class CS sec