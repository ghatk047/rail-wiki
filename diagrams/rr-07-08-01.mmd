  subgraph P1[Phase 1: Identify Grade Crossings]
    A([Start]) --> B[Identify Grade Crossing Locations\\nGCOR, C3RS]
    B --> C{Locations Identified?}
    C -- Yes --> D[Develop Outreach Plan\\NetControl, I-ETMS]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Develop and Coordinate Plan]
    D --> E[Coordinate with Local Authorities\\Harriman Dispatching Center, PS Technology]
    E --> F{Coordination Complete?}
    F -- Yes --> G[Conduct Public Meetings\\NetControl, I-ETMS]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Distribute Materials]
    G --> H[Distribute Safety Materials\\Umler, CHARM]
    H --> I{Materials Distributed?}
    I -- Yes --> J[Monitor and Report Progress\\GCOR, C3RS]
    I -- No --> Hold3([Hold])
  end

  subgraph P4[Phase 4: Review and Adjust]
    J --> K[Review and Adjust Plan\\GCOR, C3RS]
    K --> L{Plan Adjusted?}
    L -- Yes --> M[Evaluate Effectiveness\\GCOR, C3RS]
    L -- No --> Hold4([Hold])
  end

  subgraph P5[Phase 5: Report to Stakeholders]
    M --> N[Report to Stakeholders\\TRAIN II, EHMS]
    N --> O{Stakeholder Feedback?}
    O -- Yes --> P[Plan Continuous Improvement\\GCOR, C3RS]
    O -- No --> Hold5([Hold])
  end

  subgraph P6[Phase 6: Continuous Improvement]
    P --> Q[Continuous Improvement Actions\\GCOR, C3RS]
    Q --> R{Improvement Complete?}
    R -- Yes --> S([End])
    R -- No --> Hold6([Hold])
  end

