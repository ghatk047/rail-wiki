%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Initiation]
    A([Start]) --> B[Initiate Maintenance Plan\\NetControl]
    B --> C{Plan Approved?}
    C -- Yes --> D[Review Maintenance Work Order\\NetControl]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Deployment]
    D --> E[Deploy Maintenance Crew\\NetControl]
    E --> F{Crew Deployed?}
    F -- Yes --> G[Perform Network Inspection\\I-ETMS]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Defect Identification]
    G --> H[Identify Defects\\Machine Vision portals]
    H --> I{Defects Identified?}
    I -- Yes --> J[Prioritize Defects\\NetControl]
    I -- No --> Hold3([Hold])
  end

  subgraph P4[Phase 4: Scheduling Repairs]
    J --> K[Schedule Repairs\\NetControl]
    K --> L{Repairs Scheduled?}
    L -- Yes --> M[Execute Repairs\\NetControl]
    L -- No --> Hold4([Hold])
  end

  subgraph P5[Phase 5: Verification]
    M --> N[Verify Repairs\\I-ETMS]
    N --> O{Repairs Verified?}
    O -- Yes --> P[Update Maintenance Records\\NetControl]
    O -- No --> Hold5([Hold])
  end

  subgraph P6[Phase 6: Review and Reporting]
    P --> Q[Review Maintenance Log\\NetControl]
    Q --> R{Log Reviewed?}
    R -- Yes --> S[Report Maintenance Status\\NetControl]
    R -- No --> Hold6([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style S fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Hold5 fill:#20242b,color:#fff,stroke:#20242b
  style Hold6 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a