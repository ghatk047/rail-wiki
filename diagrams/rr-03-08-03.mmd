%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Arrival Notification]
    A([Start]) --> B[Train Arrival Notification\\NetControl]
    B --> C{Track Authority Granted?}
    C -- Yes --> D[Initial Inspection and Classification Planning\\EHMS]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Initial Inspection]
    D --> E{FRA Defect Found?}
    E -- Yes --> Rej1([Reject])
    E -- No --> F[Hump Yard Setup and Preparation\\I-ETMS]
  end

  subgraph P3[Phase 3: Train Classification]
    F --> G{Interchange Accepted?}
    G -- Yes --> H[Switching Operations\\NetControl]
    G -- No --> Hold2([Hold])
  end

  subgraph P4[Phase 4: Switching Operations]
    H --> I{Track Authority Granted?}
    I -- Yes --> J[Train Departure Preparation\\NetControl]
    I -- No --> Hold3([Hold])
  end

  subgraph P5[Phase 5: Final Inspection and Documentation]
    J --> K{Car Bad Ordered?}
    K -- Yes --> Rej2([Reject])
    K -- No --> L[Final Inspection and Documentation\\EHMS]
  end

  subgraph P6[Phase 6: Train Departure and Reporting]
    L --> M[Train Departure Notification\\NetControl]
    M --> N{Hours of Service Remaining?}
    N -- Yes --> O[Post-Departure Review and Reporting\\NetControl]
    N -- No --> Hold4([Hold])
    O --> P[Update Yard Schedule and Inventory\\NetControl]
    P --> Q[Interline Settlement Data Exchange SSDX\\Interline Settlement System]
    Q --> R[Final Review and Documentation\\NetControl]
    R --> S([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style S fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Rej2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style N fill:#c8791a,color:#fff,stroke:#c8791a