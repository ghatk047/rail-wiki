%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Track Inspection Planning]
    A([Start]) --> B[Track Inspection Planning\\I-ETMS]
    B --> C{Inspection plan approved?}
    C -- No --> B
    C -- Yes --> D[Automated Track Inspection\\Wabtrax, FRA Automated Track Inspection Program]
  end

  subgraph P2[Phase 2: Automated Manual Inspection]
    D --> E{FRA defect found?}
    E -- Yes --> Hold1([Hold])
    E -- No --> F[Manual Track Inspection\\NetControl, RailAI]
  end

  subgraph P3[Phase 3: Defect Prioritization]
    F --> G{Defects prioritized?}
    G -- No --> F
    G -- Yes --> H[Work Order Creation\\NetControl, TRAIN II]
  end

  subgraph P4[Phase 4: Crew Assignment Execution]
    H --> I[Maintenance Crew Assignment\\PS Technology, CrewPro]
    I --> J{Crew assigned?}
    J -- No --> I
    J -- Yes --> K[Maintenance Execution\\NetControl, RailAI]
  end

  subgraph P5[Phase 5: Post-Maintenance Inspection Closure]
    K --> L{Maintenance complete?}
    L -- No --> K
    L -- Yes --> M[Post-Maintenance Inspection\\NetControl, RailAI]
    M --> N{Inspection passed?}
    N -- No --> Hold2([Hold])
    N -- Yes --> O[Defect Closure\\I-ETMS, Umler]
  end

  subgraph P6[Phase 6: Documentation Compliance Review]
    O --> P[Maintenance Documentation\\NetControl, TRAIN II]
    P --> Q{Documentation complete?}
    Q -- No --> P
    Q -- Yes --> R[Regulatory Compliance Review\\NetControl, EHMS]
    R --> S{Compliance met?}
    S -- No --> Hold3([Hold])
    S -- Yes --> T[Continuous Improvement\\NetControl, RailAI]
  end

  T --> U([End])

  style A fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
