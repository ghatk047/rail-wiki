%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Site Identification]
    A([Start]) --> B[Identify potential sites\nLoup Logistics; ShipmentVision; up.com secure portal]
    B --> C{Site suitable for development?}
    C -- No --> B
    C -- Yes --> D[Initiate feasibility assessment]
  end

  subgraph P2[Phase 2: Site Feasibility Assessment]
    D --> E[Conduct feasibility study\nNetControl; I-ETMS; Umler]
    E --> F{Feasibility criteria met?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Develop service plan]
  end

  subgraph P3[Phase 3: Service Plan Development]
    G --> H[Create service plan\nTRAIN II; CHARM; Interline Settlement System]
    H --> I{Plan meets regulatory standards?}
    I -- No --> G
    I -- Yes --> J[Initiate customer consultation]
  end

  subgraph P4[Phase 4: Customer Consultation]
    J --> K[Consult with customer\nup.com secure portal; ShipmentVision]
    K --> L{Customer approval received?}
    L -- No --> J
    L -- Yes --> M[Submit for final approval]
  end

  subgraph P5[Phase 5: Final Approval]
    M --> N[Obtain VP Network Planning Operations approval\nNetControl; I-ETMS]
    N --> O{Approval granted?}
    O -- No --> M
    O -- Yes --> P[Plan service implementation]
  end

  subgraph P6[Phase 6: Service Implementation and Launch]
    P --> Q[Develop implementation plan\nNetControl; I-ETMS]
    Q --> R[Prepare for launch\nHarriman Dispatching Center; Umler]
    R --> S[Launch service\nNetControl; I-ETMS]
    S --> T[Monitor post-launch performance\nEHMS; Wabtrax]
    T --> U{Performance meets expectations?}
    U -- No --> Q
    U -- Yes --> V[Optimize service\nVP Network Planning Operations]
    V --> W[Final review and documentation\nNetControl; I-ETMS]
    W --> X([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style X fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style U fill:#c8791a,color:#fff,stroke:#c8791a