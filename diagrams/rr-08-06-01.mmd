%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Identify Non-Compliance]
    A([Start]) --> B[Identify Non-Compliant Tank Cars\nAskRail]
    B --> C{Non-compliance found?}
    C -- No --> A
    C -- Yes --> D[Review and Prioritize Issues\nTRANSCAER]
  end

  subgraph P2[Phase 2: Notify Affected Parties]
    D --> E[Notify Affected Parties\nNetControl]
    E --> F{Notification successful?}
    F -- No --> Hold1([Hold])
    F -- Yes --> G[Schedule Repairs or Replacement\nI-ETMS]
  end

  subgraph P3[Phase 3: Perform Repairs/Replacement]
    G --> H[Perform Tank Car Repairs or Replacement\nEHMS]
    H --> I{Repair/Replacement successful?}
    I -- No --> Hold2([Hold])
    I -- Yes --> J[Verify Compliance Post-Repair/Replacement\nTRANSCAER]
  end

  subgraph P4[Phase 4: Update Fleet Transition Plan]
    J --> K[Update Fleet Transition Plan\nUmler]
    K --> L{Plan updated?}
    L -- No --> Hold3([Hold])
    L -- Yes --> M[Procure New Tank Cars\nTRAIN II]
  end

  subgraph P5[Phase 5: Integrate New Tank Cars]
    M --> N[Integrate New Tank Cars into Fleet\nI-ETMS]
    N --> O{Integration successful?}
    O -- No --> Hold4([Hold])
    O -- Yes --> P[Monitor Fleet Compliance and Performance\nAskRail]
  end

  subgraph P6[Phase 6: Review and Report]
    P --> Q[Review and Adjust Fleet Transition Strategy\nUmler]
    Q --> R{Strategy reviewed?}
    R -- No --> Hold5([Hold])
    R -- Yes --> S[Report to Stakeholders\nTRANSCAER]
    S --> T([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Hold5 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style L fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style R fill:#c8791a,color:#fff,stroke:#c8791a