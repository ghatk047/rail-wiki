%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Arrival]
    A([Start]) --> B[Train Arrival Notification\\NetControl]
    B --> C{Track Authority Granted?}
    C -- Yes --> D[Train Positioning\\Hump yard classification technology]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Car Sorting]
    D --> E[Car Sorting\\Hump yard classification technology]
    E --> F{Interchange Accepted?}
    F -- Yes --> G[Train Assembly\\Hump yard classification technology]
    F -- No --> Hold2([Hold])
  end

  subgraph P3[Phase 3: Train Departure Preparation]
    G --> H[Car Inspection\\EHMS]
    H --> I{FRA Defect Found?}
    I -- Yes --> J[Report Defect\\Wayside defect detector network]
    I -- No --> K[Train Departure Notification\\NetControl]
  end

  subgraph P4[Phase 4: Train Departure]
    K --> L[Train Departure\\I-ETMS]
    L --> M{PTC Initialized?}
    M -- Yes --> N[Train Monitoring\\I-ETMS]
    M -- No --> Hold3([Hold])
  end

  subgraph P5[Phase 5: Post-Departure Review]
    N --> O[Post-Departure Review\\NetControl]
    O --> P{Car Bad Ordered?}
    P -- Yes --> Q[Report Bad Order\\NetControl]
    P -- No --> R[Settlement Data Exchange\\Interline Settlement System ISS]
  end

  subgraph P6[Phase 6: Maintenance Scheduling]
    R --> S[Maintenance Scheduling\\EHMS]
    S --> T{Hours of Service Remaining?}
    T -- Yes --> U([End])
    T -- No --> Hold4([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style F fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style P fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a