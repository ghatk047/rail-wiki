%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Receive Request]
    A([Start]) --> B[Receive Trackage Rights Request\nCHARM]
    B --> C{Request Valid?}
    C -- Yes --> D[Review and Validate Request\nUmler]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Negotiation]
    D --> E{Validation Passed?}
    E -- Yes --> F[Negotiate Terms and Conditions\nNetControl]
    E -- No --> Rej1([Reject])
    F --> G{Negotiation Successful?}
    G -- Yes --> H[Approve Trackage Rights Agreement\nTRAIN II]
    G -- No --> D
  end

  subgraph P3[Phase 3: Database Update]
    H --> I{Approval Granted?}
    I -- Yes --> J[Update Trackage Rights Database\nCHARM]
    I -- No --> Rej1
    J --> K([End])
  end

  subgraph P4[Phase 4: Notification]
    J --> L[Notify Affected Railroads\nNetControl]
    L --> M{Notification Sent?}
    M -- Yes --> N[Prepare Train Schedule\nI-ETMS]
    M -- No --> Hold2([Hold])
  end

  subgraph P5[Phase 5: Schedule Review]
    N --> O{Schedule Ready?}
    O -- Yes --> P[Review and Adjust Schedule\nI-ETMS]
    O -- No --> L
    P --> Q{Schedule Approved?}
    Q -- Yes --> R[Implement Train Schedule\nI-ETMS]
    Q -- No --> N
  end

  subgraph P6[Phase 6: Operation Monitoring]
    R --> S[Monitor Train Operations\nI-ETMS]
    S --> T{Operations Normal?}
    T -- Yes --> U([End])
    T -- No --> V[Handle Exceptions\nI-ETMS]
    V --> W{Exception Handled?}
    W -- Yes --> X[Finalize and Report\nCHARM]
    W -- No --> S
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style K fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a
  style O fill:#c8791a,color:#fff,stroke:#c8791a
  style Q fill:#c8791a,color:#fff,stroke:#c8791a
  style T fill:#c8791a,color:#fff,stroke:#c8791a
  style W fill:#c8791a,color:#fff,stroke:#c8791a