flowchart LR
  subgraph P1[Phase 1: Locomotive Identification and Scheduling]
    A([Start]) --> B[Locomotive Identification\\Umler]
    B --> C{Scheduling Approved?}
    C -- No --> B
    C -- Yes --> D[Initial Inspection and Defect Logging\\Wayside defect detector network]
  end

  subgraph P2[Phase 2: Initial Inspection and Defect Logging]
    D --> E{Defect Found?}
    E -- No --> F[Component Replacement and Repair\\Downing B. Jenks Shop]
    E -- Yes --> Hold1([Hold])
  end

  subgraph P3[Phase 3: Component Replacement and Repair]
    F --> G{Repair Complete?}
    G -- No --> F
    G -- Yes --> H[Testing and Calibration\\Wabtec Modular Control Architecture]
  end

  subgraph P4[Phase 4: Testing and Calibration]
    H --> I{Calibration Passed?}
    I -- No --> Hold2([Hold])
    I -- Yes --> J[Final Inspection and Documentation\\EHMS]
  end

  subgraph P5[Phase 5: Final Inspection and Documentation]
    J --> K{Inspection Approved?}
    K -- No --> H
    K -- Yes --> L[Return to Service Approval\\Umler]
  end

  subgraph P6[Phase 6: Post-Overhaul Monitoring and Review]
    L --> M{Approval Granted?}
    M -- No --> Hold3([Hold])
    M -- Yes --> N[Post-Overhaul Monitoring\\NetControl]
    N --> O[Feedback and Continuous Improvement\\TRAIN II]
    O --> P[Safety Audit and Compliance Check\\I-ETMS]
    P --> Q{Audit Passed?}
    Q -- No --> L
    Q -- Yes --> R[Final Documentation Update\\Umler]
    R --> S[Post-Overhaul Review Meeting\\TRAIN II]
    S --> T[Close Out and Handover\\NetControl]
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style T fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
