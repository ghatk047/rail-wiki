flowchart LR
  subgraph P1[Phase 1: Application Submission]
    A([Start]) --> B[Initial Application Submission\\nPS Technology PST]
    B --> C{Application complete?}
    C -- No --> B
    C -- Yes --> D[Background Check and Medical Clearance\\nCloudMoyo Crew Management CCM]
  end

  subgraph P2[Phase 2: Background Check]
    D --> E{Check Passed?}
    E -- No --> Rej1([Reject])
    E -- Yes --> F[Initial Training Assignment\\nHASTUS]
  end

  subgraph P3[Phase 3: Initial Training]
    F --> G{Training Complete?}
    G -- No --> F
    G -- Yes --> H[On-the-Job Training OJT\\nPS Technology PST, EHMS]
  end

  subgraph P4[Phase 4: OJT Completion]
    H --> I{OJT Passed?}
    I -- No --> H
    I -- Yes --> J[Written Exam Preparation\\nPS Technology PST]
  end

  subgraph P5[Phase 5: Written Exam]
    J --> K{Exam Passed?}
    K -- No --> J
    K -- Yes --> L[Practical Exam Preparation\\nPS Technology PST, EHMS]
  end

  subgraph P6[Phase 6: Practical Exam and Certification]
    L --> M{Practical Exam Passed?}
    M -- No --> L
    M -- Yes --> N[Certification Review\\nPS Technology PST, CloudMoyo Crew Management CCM]
    N --> O{Review Approved?}
    O -- No --> Rej2([Reject])
    O -- Yes --> P[Certification Issuance\\nPS Technology PST, CloudMoyo Crew Management CCM]
    P --> Q[Certification Maintenance\\nPS Technology PST, CloudMoyo Crew Management CCM]
    Q --> R{Maintenance Complete?}
    R -- No --> Q
    R -- Yes --> S[Annual Review and Recertification\\nPS Technology PST, CloudMoyo Crew Management CCM]
    S --> T{Recertification Approved?}
    T -- No --> Rej3([Reject])
    T -- Yes --> U([End])
  end

