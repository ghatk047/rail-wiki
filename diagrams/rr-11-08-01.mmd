%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Train Arrival Notification]
    A([Start]) --> B[Train Arrival Notification\\NetControl]
    B --> C{Track Authority Granted?}
    C -- Yes --> D[Car Inspection\\Wabtrax, Wayside defect detector network]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Car Inspection]
    D --> E{FRA Defect Found?}
    E -- Yes --> Rej1([Reject])
    E -- No --> F[Car Hire Settlement Request\\Interline Settlement System ISS, Car Hire Data Exchange CHDX]
  end

  subgraph P3[Phase 3: Car Hire Settlement]
    F --> G{Settlement Approved?}
    G -- Yes --> H[Equipment Registration Update\\Umler, TRAIN II]
    G -- No --> Hold2([Hold])
  end

  subgraph P4[Phase 4: Equipment Registration]
    H --> I{Interchange Accepted?}
    I -- Yes --> J[Train Departure Preparation\\PS Technology PST, Harriman Dispatching Center HDC]
    I -- No --> Rej2([Reject])
  end

  subgraph P5[Phase 5: Train Departure Preparation]
    J --> K[Equipment Health Check\\EHMS Equipment Health Management System]
    K --> L{Health Check Passed?}
    L -- Yes --> M[Train Departure Notification\\NetControl, I-ETMS]
    L -- No --> Hold3([Hold])
  end

  subgraph P6[Phase 6: Post-Departure Review and Continuous Improvement]
    M --> N[Settlement Confirmation\\Interline Settlement System ISS, Car Hire Data Exchange CHDX]
    N --> O{Confirmation Approved?}
    O -- Yes --> P[Regulatory Compliance Check\\Umler, TRAIN II]
    O -- No --> Hold4([Hold])
    P --> Q{Compliance Passed?}
    Q -- Yes --> R[Continuous Improvement Planning\\NetControl, I-ETMS]
    Q -- No --> Rej3([Reject])
    R --> S[Final Settlement Adjustment\\Interline Settlement System ISS, Car Hire Data Exchange CHDX]
    S --> T{Adjustment Approved?}
    T -- Yes --> U([End])
    T -- No --> Hold5([Hold])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Rej2 fill:#20242b,color:#fff,stroke:#20242b
  style Rej3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Hold3 fill:#20242b,color:#fff,stroke:#20242b
  style Hold4 fill:#20242b,color:#fff,stroke:#20242b
  style Hold5 fill:#20242b,color:#fff,stroke:#20242b
