%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Recruitment and Initial Screening]
    A([Start]) --> B[Recruitment and Initial Screening\\NetControl]
    B --> C{Pass initial screening?}
    C -- Yes --> D[Orientation and Safety Training\\Mobile classroom training trailers]
    C -- No --> Hold1([Hold])
  end

  subgraph P2[Phase 2: Orientation and Safety Training]
    D --> E{Complete orientation and safety training?}
    E -- Yes --> F[Technical Training in Simulator\\I-ETMS]
    E -- No --> Rej1([Reject])
  end

  subgraph P3[Phase 3: Technical Training in Simulator]
    F --> G{Pass simulator test?}
    G -- Yes --> H[Field Training Assignment\\NetControl]
    G -- No --> D
  end

  subgraph P4[Phase 4: Field Training Assignment]
    H --> I{Accept field training assignment?}
    I -- Yes --> J[On-the-Job Training and Mentorship\\NetControl]
    I -- No --> Hold2([Hold])
  end

  subgraph P5[Phase 5: On-the-Job Training and Mentorship]
    J --> K{Complete on-the-job training?}
    K -- Yes --> L[Final Evaluation and Certification\\Mobile classroom training trailers]
    K -- No --> H
  end

  subgraph P6[Phase 6: Final Evaluation and Certification]
    L --> M{Pass final evaluation?}
    M -- Yes --> N([End])
    M -- No --> Rej2([Reject])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style N fill:#20242b,color:#fff,stroke:#20242b
  style Rej1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold1 fill:#20242b,color:#fff,stroke:#20242b
  style Hold2 fill:#20242b,color:#fff,stroke:#20242b
  style Rej2 fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
  style E fill:#c8791a,color:#fff,stroke:#c8791a
  style G fill:#c8791a,color:#fff,stroke:#c8791a
  style I fill:#c8791a,color:#fff,stroke:#c8791a
  style K fill:#c8791a,color:#fff,stroke:#c8791a
  style M fill:#c8791a,color:#fff,stroke:#c8791a