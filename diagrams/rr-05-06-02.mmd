%%{init: {'theme':'base','themeVariables':{'fontSize':'13px','fontFamily':'Helvetica Neue, Helvetica, Arial, sans-serif'}}}%%
flowchart LR
  subgraph P1[Phase 1: Anomaly Detection]
    A([Start]) --> B[Detect anomaly\\Wayside defect detector network]
    B --> C{Anomaly detected?}
    C -- No --> B
    C -- Yes --> D[Initial assessment\\EHMS]
  end

  subgraph P2[Phase 2: Prioritization and Dispatch]
    D --> E{Assessment complete?}
    E -- No --> D
    E -- Yes --> F[Prioritize repair\\NetControl]
    F --> G{Priority set?}
    G -- No --> F
    G -- Yes --> H[Dispatch repair crew\\NetControl]
  end

  subgraph P3[Phase 3: Locomotive Inspection]
    H --> I{Crew dispatched?}
    I -- No --> H
    I -- Yes --> J[Locomotive inspection\\Wabtec Modular Control Architecture]
    J --> K{Inspection complete?}
    K -- No --> J
    K -- Yes --> L[Repair or replace\\Downing B. Jenks Shop, North Platte, NE locomotive shop, Proviso Locomotive Shop, West Colton Yard and Shops]
  end

  subgraph P4[Phase 4: Quality Control]
    L --> M{Repair complete?}
    M -- No --> L
    M -- Yes --> N[Quality control\\EHMS]
    N --> O{QC passed?}
    O -- No --> L
    O -- Yes --> P[Return to service\\NetControl]
  end

  subgraph P5[Phase 5: Record Update]
    P --> Q{Returned to service?}
    Q -- No --> P
    Q -- Yes --> R[Update records\\Umler, EHMS]
  end

  subgraph P6[Phase 6: Review and Improve]
    R --> S[Review and improve\\EHMS, TRAIN II]
    S --> T{Improvement complete?}
    T -- No --> S
    T -- Yes --> U([End])
  end

  style A fill:#20242b,color:#fff,stroke:#20242b
  style U fill:#20242b,color:#fff,stroke:#20242b
  style C fill:#c8791a,color:#fff,stroke:#c8791a
